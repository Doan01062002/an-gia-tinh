---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showSubtitle?: boolean;
  theme?: 'light' | 'dark';
  class?: string;
}

const { size = 'md', showSubtitle = true, theme = 'light', class: className = '' } = Astro.props;

const iconSizes = {
  sm: 'w-7 h-7 sm:w-8 sm:h-8',
  md: 'w-8 h-8 sm:w-10 sm:h-10 lg:w-11 lg:h-11',
  lg: 'w-10 h-10 sm:w-12 sm:h-12 lg:w-14 lg:h-14',
};

const titleSizes = {
  sm: 'text-xs sm:text-sm font-black tracking-wider',
  md: 'text-sm sm:text-lg lg:text-xl font-black tracking-wide',
  lg: 'text-lg sm:text-xl lg:text-2xl font-black tracking-wide',
};

const subSizes = {
  sm: 'text-[7.5px] sm:text-[8.5px] font-bold tracking-widest',
  md: 'text-[8px] sm:text-[9.5px] font-bold tracking-widest',
  lg: 'text-[9.5px] sm:text-[11px] font-bold tracking-widest',
};
---

<div class={`flex items-center gap-1.5 sm:gap-2.5 group ${className}`}>
  {/* Sacred Altar & Lotus Emblem (Vector SVG) */}
  <div class={`relative shrink-0 ${iconSizes[size]} rounded-xl bg-gradient-to-br from-[#8B0000] via-[#A0111E] to-[#680000] border-2 border-amber-400/90 shadow-md flex items-center justify-center p-1.5 transition-transform duration-300 group-hover:scale-105`}>
    <svg
      viewBox="0 0 100 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-full drop-shadow-sm"
    >
      <defs>
        <linearGradient id="gold-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FDE68A" />
          <stop offset="50%" stop-color="#F59E0B" />
          <stop offset="100%" stop-color="#B45309" />
        </linearGradient>
        <linearGradient id="gold-light" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#F59E0B" />
          <stop offset="100%" stop-color="#FFFBEB" />
        </linearGradient>
      </defs>

      {/* Altar Curved Roof / Mái Đình */}
      <path
        d="M 12 36 C 24 28 38 24 50 24 C 62 24 76 28 88 36 C 82 34 68 30 50 30 C 32 30 18 34 12 36 Z"
        fill="url(#gold-light)"
      />

      {/* Central Radiating Sacred Lotus (Hoa Sen Liên Hoa 7 Cánh) */}
      {/* Center Petal */}
      <path
        d="M 50 20 C 44 32 44 48 50 56 C 56 48 56 32 50 20 Z"
        fill="url(#gold-grad)"
      />
      {/* Left Inner Petal */}
      <path
        d="M 46 26 C 36 36 36 50 46 56 C 45 46 45 36 46 26 Z"
        fill="url(#gold-grad)"
        opacity="0.9"
      />
      {/* Right Inner Petal */}
      <path
        d="M 54 26 C 64 36 64 50 54 56 C 55 46 55 36 54 26 Z"
        fill="url(#gold-grad)"
        opacity="0.9"
      />
      {/* Left Outer Petal */}
      <path
        d="M 41 33 C 26 42 28 55 42 58 C 38 50 38 41 41 33 Z"
        fill="url(#gold-grad)"
        opacity="0.8"
      />
      {/* Right Outer Petal */}
      <path
        d="M 59 33 C 74 42 72 55 58 58 C 62 50 62 41 59 33 Z"
        fill="url(#gold-grad)"
        opacity="0.8"
      />

      {/* Altar Pedestal / Bệ Thờ Đài Sen */}
      <path
        d="M 24 64 L 76 64 L 70 70 L 30 70 Z"
        fill="url(#gold-light)"
      />
      <path
        d="M 20 72 L 80 72 L 74 78 L 26 78 Z"
        fill="url(#gold-grad)"
      />
      {/* Base Foundation */}
      <rect x="16" y="80" width="68" height="5" rx="2.5" fill="url(#gold-light)" />

      {/* Central Auspicious Pearl / Viên Ngọc Minh Châu */}
      <circle cx="50" cy="56" r="4.5" fill="#FFFBEB" stroke="#B45309" stroke-width="1.5" />
    </svg>
  </div>

  {/* Typography */}
  <div class="leading-none">
    <div class="flex items-center gap-1.5">
      <span class={`block font-black transition-colors ${theme === 'dark' ? 'text-white group-hover:text-amber-300' : 'text-stone-900 group-hover:text-red-800'} ${titleSizes[size]}`}>
        AN GIA TỊNH
      </span>
    </div>

    {showSubtitle && (
      <span class={`block uppercase font-bold mt-0.5 tracking-wider ${theme === 'dark' ? 'text-amber-400' : 'text-amber-800'} ${subSizes[size]}`}>
        Đồ Thờ Chuẩn Lỗ Ban
      </span>
    )}
  </div>
</div>