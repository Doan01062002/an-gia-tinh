---
import BrandLogo from './BrandLogo.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const navLinks = [
  { href: "/", label: "Trang Chủ" },
  { href: "/san-pham", label: "Mẫu Bàn Thờ" },
  { href: "/thuoc-lo-ban", label: "Thước Lỗ Ban 38.8" },
  { href: "/kien-thuc", label: "Cẩm Nang Thờ Cúng" },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-stone-200/90 shadow-xs text-stone-900">
  {/* Top Bar Announcement: Visible only on Desktop (>= 768px) to save precious vertical space on mobile */}
  <div class="hidden md:block bg-stone-50 border-b border-stone-200/80 px-4 py-1.5 text-xs text-stone-600">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-2 truncate">
        <span class="inline-block w-2 h-2 rounded-full bg-amber-600 animate-pulse shrink-0"></span>
        <span class="font-bold text-amber-900 shrink-0">AN GIA TỊNH:</span>
        <span class="text-stone-700 truncate">100% Gỗ Tự Nhiên Tuyển Chọn • Chuẩn Thước Lỗ Ban 38.8cm • Giao Toàn Quốc</span>
      </div>
      <div class="flex items-center gap-3 text-xs shrink-0">
        <span class="text-emerald-700 font-medium">Giao hàng & Lắp đặt tận nơi</span>
        <span class="text-stone-300">•</span>
        <a href="tel:0339533380" class="hover:text-amber-800 font-semibold text-stone-800 flex items-center gap-1">
          Hotline: 0339.533.380
        </a>
      </div>
    </div>
  </div>

  {/* Main Navbar: Sleek, compact, zero text wrap */}
  <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-15 lg:h-16">
      {/* Brand Logo & Name */}
      <a href="/" class="shrink-0" aria-label="Trang chủ An Gia Tịnh">
        <BrandLogo size="md" />
      </a>

      {/* Desktop Links */}
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href.replace(/\/$/, "");
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 text-sm font-semibold rounded-xl transition-all ${
                isActive
                  ? "text-amber-900 bg-amber-50/80 border border-amber-200/80"
                  : "text-stone-700 hover:text-stone-950 hover:bg-stone-100"
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      {/* Desktop Actions */}
      <div class="hidden sm:flex items-center gap-2.5">
        <a
          href="/thuoc-lo-ban"
          class="flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-stone-800 bg-stone-100 hover:bg-stone-200 border border-stone-200 rounded-xl transition-all"
        >
          <span>Tra Thước Lỗ Ban</span>
        </a>

        <a
          href="https://zalo.me/0339533380"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 px-4 py-2 bg-[#0068FF] hover:bg-[#0052cc] text-white font-bold text-xs sm:text-sm rounded-xl shadow-xs transition-all"
        >
          <span>Zalo: 0339.533.380</span>
        </a>
      </div>

      {/* Mobile Actions: Hotline pill & Menu button kept on top-right as requested */}
      <div class="flex md:hidden items-center gap-1.5 sm:gap-2 shrink-0 pr-1">
        <a
          href="tel:0339533380"
          class="flex items-center gap-1 px-2 py-1 sm:px-2.5 sm:py-1.5 rounded-full border border-red-700 text-red-800 font-bold text-[10px] sm:text-xs hover:bg-red-50 transition-colors shadow-2xs whitespace-nowrap"
          aria-label="Gọi hotline: 0339.533.380"
        >
          <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-red-700 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>0339.533.380</span>
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Mở menu điều hướng"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-stone-100 border border-stone-300 text-stone-800 flex items-center justify-center hover:bg-stone-200 active:scale-95 transition-all shrink-0 cursor-pointer"
        >
          <svg class="w-5 h-5 text-stone-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Drawer Panel: Placed outside <header> to avoid backdrop-filter stacking context trap on mobile Safari/Chrome -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-[100] bg-[#2d1810]/70 backdrop-blur-xs hidden opacity-0 transition-opacity duration-300"
  aria-label="Menu điều hướng di động"
  role="dialog"
  aria-modal="true"
>
  <div
    id="mobile-drawer-panel"
    class="fixed top-0 right-0 w-72 max-w-[85vw] h-full h-dvh bg-white border-l border-stone-200 p-5 flex flex-col justify-between shadow-2xl overflow-y-auto transform translate-x-full transition-transform duration-300 ease-out"
  >
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-stone-200">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-700">
            <svg class="w-4 h-4 text-amber-700" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C12 2 8 8 8 13C8 16.5 10.5 19 12 19C13.5 19 16 16.5 16 13C16 8 12 2 12 2ZM12 17C11.2 17 9.8 15.2 9.8 13C9.8 10.4 11.5 6.4 12 5.1C12.5 6.4 14.2 10.4 14.2 13C14.2 15.2 12.8 17 12 17Z"/>
            </svg>
          </div>
          <div>
            <span class="block font-black text-stone-900 text-sm">AN GIA TỊNH</span>
            <span class="block text-[8px] text-amber-800 uppercase font-semibold">Đồ Thờ Làng Nghề</span>
          </div>
        </div>
        <button
          id="mobile-close-btn"
          type="button"
          class="p-2 -mr-2 text-stone-500 hover:text-stone-900 active:scale-95 transition-transform"
          aria-label="Đóng menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="py-4 space-y-1">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href.replace(/\/$/, "");
          return (
            <a
              href={link.href}
              class={`block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
                isActive
                  ? "text-amber-900 bg-amber-50 border border-amber-200"
                  : "text-stone-800 hover:text-amber-800 hover:bg-stone-50"
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="pt-4 border-t border-stone-200 space-y-2.5">
      <a
        href="/thuoc-lo-ban"
        class="w-full py-2.5 bg-stone-100 hover:bg-stone-200 border border-stone-300 text-stone-900 font-bold text-xs rounded-xl flex items-center justify-center gap-1.5 transition-colors"
      >
        <span>Tra Thước Lỗ Ban 38.8cm</span>
      </a>
      <a
        href="tel:0339533380"
        class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-1.5 shadow-xs transition-colors"
      >
        <span>Hotline: 0339.533.380</span>
      </a>
      <a
        href="https://zalo.me/0339533380"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-2.5 bg-[#0068FF] hover:bg-[#0052cc] text-white font-bold text-xs rounded-xl flex items-center justify-center gap-1.5 shadow-xs transition-colors"
      >
        <span>Nhắn Zalo Thợ Cả 24/7</span>
      </a>
    </div>
  </div>
</div>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-close-btn');
    const drawer = document.getElementById('mobile-drawer');
    const panel = document.getElementById('mobile-drawer-panel');

    if (!menuBtn || !closeBtn || !drawer || !panel) return;

    function openDrawer() {
      drawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      // Trigger CSS transition
      requestAnimationFrame(() => {
        drawer.classList.remove('opacity-0');
        drawer.classList.add('opacity-100');
        panel.classList.remove('translate-x-full');
        panel.classList.add('translate-x-0');
      });
    }

    function closeDrawer() {
      drawer.classList.remove('opacity-100');
      drawer.classList.add('opacity-0');
      panel.classList.remove('translate-x-0');
      panel.classList.add('translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => {
        drawer.classList.add('hidden');
      }, 300);
    }

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openDrawer();
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeDrawer();
    });

    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) {
        closeDrawer();
      }
    });

    // Close when clicking any link inside drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        closeDrawer();
      }
    });
  }

  // Support initial load and Astro client navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
