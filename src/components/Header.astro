---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const navLinks = [
  { href: "/", label: "Trang Chủ" },
  { href: "/san-pham", label: "Mẫu Bàn Thờ" },
  { href: "/thuoc-lo-ban", label: "Thước Lỗ Ban 38.8" },
  { href: "/kien-thuc", label: "Văn Khấn & Phong Thủy" },
];
---

<header class="sticky top-0 z-40 bg-wood-950/95 backdrop-blur-md border-b border-wood-800 text-white shadow-lg">
  {/* Top bar */}
  <div class="bg-wood-900 border-b border-wood-800/80 px-4 py-1.5 text-xs text-wood-200">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="text-gold-400 font-bold">★ CAM KẾT:</span>
        <span>100% Gỗ lõi không rác (Đền bù 200%) • Gửi video mộc 15s trước khi giao</span>
      </div>
      <div class="flex items-center gap-4 text-wood-300">
        <span>Làng nghề Thạch Thất & Sơn Đồng, Hà Nội</span>
        <span class="hidden sm:inline">•</span>
        <a href="tel:0339533380" class="hover:text-gold-300 transition-colors font-medium">Hotline: 0339.533.380</a>
      </div>
    </div>
  </div>

  {/* Main navigation */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-full bg-gradient-to-br from-gold-400 via-gold-500 to-wood-800 flex items-center justify-center text-wood-950 text-2xl shadow-md border border-gold-300 group-hover:scale-105 transition-transform">
          🪷
        </div>
        <div>
          <span class="block text-xl sm:text-2xl font-serif font-black tracking-wider text-white group-hover:text-gold-300 transition-colors">
            AN GIA TỊNH
          </span>
          <span class="block text-[10px] sm:text-xs text-gold-300 tracking-widest uppercase font-medium">
            Trọn Vẹn Tâm Linh – Bình An Gia Đạo
          </span>
        </div>
      </a>

      {/* Desktop Navigation Links */}
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href.replace(/\/$/, "");
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 text-sm font-medium rounded-lg transition-colors ${
                isActive
                  ? "bg-wood-800 text-gold-300 font-bold border border-gold-500/30"
                  : "text-wood-200 hover:text-white hover:bg-wood-900"
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      {/* Action / Hotline CTA */}
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/thuoc-lo-ban"
          class="px-3.5 py-2 text-xs font-semibold text-gold-300 hover:text-white bg-wood-900 hover:bg-wood-800 border border-gold-500/40 rounded-lg transition-all"
        >
          Tra Cứu Lỗ Ban
        </a>
        <a
          href="https://zalo.me/0339533380"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-500 hover:to-gold-600 text-wood-950 font-bold text-xs sm:text-sm rounded-lg shadow-md hover:shadow-gold-500/20 transition-all"
        >
          <span>💬</span>
          <span>Zalo: 0339.533.380</span>
        </a>
      </div>

      {/* Mobile menu trigger */}
      <div class="flex md:hidden items-center gap-2">
        <a
          href="tel:0339533380"
          class="p-2 bg-gold-400 text-wood-950 rounded-lg font-bold text-xs"
        >
          📞 Gọi Xưởng
        </a>
      </div>
    </div>

    {/* Mobile sub-links bar */}
    <div class="flex md:hidden overflow-x-auto py-2.5 gap-2 border-t border-wood-800/60 no-scrollbar text-xs">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3 py-1.5 whitespace-nowrap rounded-md bg-wood-900 text-wood-200 hover:text-white"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>
