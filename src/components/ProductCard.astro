---
import type { Product } from '../types';

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}
---

<div class="group bg-white rounded-2xl overflow-hidden border border-stone-200 hover:border-amber-400 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col h-full hover:-translate-y-1">
  {/* Image Container */}
  <div class="relative aspect-4/3 overflow-hidden bg-stone-100">
    <img
      src={product.imageUrl}
      alt={product.name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />

    {/* Badge */}
    {product.badge && (
      <span class="absolute top-3 left-3 px-3 py-1 bg-amber-600 text-white text-[11px] font-bold tracking-wider uppercase rounded-full shadow-sm">
        {product.badge}
      </span>
    )}

    {/* Warranty Pill */}
    <span class="absolute bottom-3 right-3 px-2.5 py-1 bg-stone-900/80 backdrop-blur-md text-amber-300 text-[11px] font-medium rounded-md shadow-xs">
      Bảo hành {product.warrantyYears} năm
    </span>
  </div>

  {/* Content */}
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
    <div>
      <div class="flex items-center justify-between text-xs text-stone-500 mb-2">
        <span class="font-bold uppercase tracking-wider text-amber-800">
          {product.categoryName}
        </span>
        <div class="flex items-center gap-1 text-amber-600 font-bold">
          <span>★</span>
          <span>{product.rating}</span>
          <span class="text-stone-400 font-normal">({product.reviewCount})</span>
        </div>
      </div>

      <h3 class="text-base sm:text-lg font-serif font-bold text-stone-900 group-hover:text-amber-800 transition-colors line-clamp-2 leading-snug mb-2">
        <a href={`/san-pham/${product.slug}`}>
          {product.name}
        </a>
      </h3>

      {/* Lỗ Ban Auspicious Badge */}
      <div class="p-2.5 rounded-xl bg-red-50 border border-red-200 text-xs text-red-900 space-y-0.5">
        <div class="flex items-center justify-between font-bold text-red-700">
          <span>Thước Lỗ Ban 38.8cm:</span>
          <span class="text-[10px] bg-red-700 text-white px-2 py-0.5 rounded-full uppercase">
            Cung Đỏ
          </span>
        </div>
        <p class="text-[11px] text-stone-700 leading-tight">
          • Kích thước: <strong>{product.dimensions}</strong><br />
          • Cung: <strong>{product.lobanInfo.depthCung}</strong> — <strong>{product.lobanInfo.widthCung}</strong>
        </p>
      </div>

      {/* Wood Type */}
      <div class="mt-2.5 text-xs text-stone-600 font-medium">
        Chất liệu: <strong class="text-stone-800">{product.woodType}</strong>
      </div>
    </div>

    {/* Price & Action */}
    <div class="pt-4 border-t border-stone-100">
      <div class="flex items-baseline justify-between mb-3.5">
        <div>
          <span class="text-lg sm:text-xl font-serif font-black text-red-700">
            {formatCurrency(product.price)}
          </span>
          <span class="text-xs text-stone-400 line-through ml-2">
            {formatCurrency(product.originalPrice)}
          </span>
        </div>
        <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
          100% Gỗ Lõi
        </span>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <a
          href={`/san-pham/${product.slug}`}
          class="px-3 py-2 text-center text-xs font-bold text-stone-800 bg-stone-100 hover:bg-stone-200 rounded-xl transition-colors border border-stone-200"
        >
          Xem Chi Tiết
        </a>

        <a
          href="https://zalo.me/0339533380"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2 text-center text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-xs transition-colors"
        >
          Nhận Clip Mộc
        </a>
      </div>
    </div>
  </div>
</div>
