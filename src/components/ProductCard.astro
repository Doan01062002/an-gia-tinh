---
import type { Product } from '../types';

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}
---

<div class="group bg-white rounded-3xl overflow-hidden border border-[#E6DED3] hover:border-[#CFA439]/60 shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col h-full hover:-translate-y-1.5">
  {/* Image Container */}
  <div class="relative aspect-4/3 overflow-hidden bg-[#F4E8DC]">
    <img
      src={product.imageUrl}
      alt={product.name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#190F0A]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

    {/* Badge */}
    {product.badge && (
      <span class="absolute top-3 left-3 px-3 py-1 bg-[#8F1717] text-[#FBF5DF] text-[11px] font-bold tracking-wider uppercase rounded-full shadow-md border border-[#CFA439]/30">
        {product.badge}
      </span>
    )}

    {/* Warranty Pill */}
    <span class="absolute bottom-3 right-3 px-3 py-1 bg-[#1C100A]/85 backdrop-blur-md text-[#E2BE5F] text-[11px] font-semibold rounded-lg border border-[#CFA439]/40 shadow-sm">
      Bảo hành {product.warrantyYears} năm
    </span>
  </div>

  {/* Card Body */}
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
    <div>
      {/* Category & Rating */}
      <div class="flex items-center justify-between text-xs text-[#73432C] mb-2">
        <span class="font-bold uppercase tracking-wider text-[#AF8729]">
          {product.categoryName}
        </span>
        <div class="flex items-center gap-1 text-[#AF8729] font-bold">
          <svg class="w-3.5 h-3.5 fill-current text-[#CFA439]" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>{product.rating}</span>
          <span class="text-[#A88B74] font-normal">({product.reviewCount})</span>
        </div>
      </div>

      {/* Product Title */}
      <h3 class="text-base sm:text-lg font-serif-classic font-bold text-[#190F0A] group-hover:text-[#8F1717] transition-colors line-clamp-2 leading-snug mb-3">
        <a href={`/san-pham/${product.slug}`}>
          {product.name}
        </a>
      </h3>

      {/* Lỗ Ban Auspicious Highlight Box */}
      <div class="p-3 rounded-xl bg-[#FEF2F2] border border-[#8F1717]/30 text-xs text-[#8F1717] space-y-1">
        <div class="flex items-center justify-between font-bold">
          <span>Chuẩn Thước Lỗ Ban 38.8cm:</span>
          <span class="text-[10px] bg-[#8F1717] text-white px-2 py-0.5 rounded-full font-sans uppercase">
            Cung Đỏ
          </span>
        </div>
        <p class="text-[11px] text-[#543120] leading-tight">
          • Kích thước: <strong>{product.dimensions}</strong><br />
          • Cát tường: <strong>{product.lobanInfo.depthCung}</strong> — <strong>{product.lobanInfo.widthCung}</strong>
        </p>
      </div>

      {/* Wood Type */}
      <div class="mt-3 flex items-center gap-1.5 text-xs text-[#543120]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#AF8729]"></span>
        <span class="font-medium">{product.woodType}</span>
      </div>
    </div>

    {/* Pricing and Action */}
    <div class="pt-4 border-t border-[#E6DED3]">
      <div class="flex items-baseline justify-between mb-4">
        <div>
          <span class="text-lg sm:text-xl font-serif-classic font-black text-[#8F1717]">
            {formatCurrency(product.price)}
          </span>
          <span class="text-xs text-[#A88B74] line-through ml-2">
            {formatCurrency(product.originalPrice)}
          </span>
        </div>
        <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">
          100% Gỗ Lõi
        </span>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <a
          href={`/san-pham/${product.slug}`}
          class="px-3 py-2.5 text-center text-xs font-bold text-[#190F0A] bg-[#F4E8DC] hover:bg-[#E8D0BD] rounded-xl transition-colors border border-[#D8C7B5]"
        >
          Xem Chi Tiết
        </a>

        <a
          href="https://zalo.me/0339533380"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2.5 text-center text-xs font-bold text-[#FBF5DF] bg-[#190F0A] hover:bg-[#2C190F] border border-[#CFA439]/50 rounded-xl shadow-sm transition-all"
        >
          Nhận Clip Mộc
        </a>
      </div>
    </div>
  </div>
</div>
