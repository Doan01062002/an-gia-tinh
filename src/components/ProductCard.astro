---
import type { Product } from '../types';

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}
---

<div class="group bg-white rounded-2xl overflow-hidden border border-wood-100 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col h-full hover:-translate-y-1">
  {/* Image container */}
  <div class="relative aspect-4/3 overflow-hidden bg-wood-100">
    <img
      src={product.imageUrl}
      alt={product.name}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    {product.badge && (
      <span class="absolute top-3 left-3 px-3 py-1 bg-red-600 text-white text-xs font-bold rounded-full shadow-md">
        {product.badge}
      </span>
    )}
    <span class="absolute bottom-3 right-3 px-2.5 py-1 bg-wood-900/80 backdrop-blur-sm text-gold-300 text-[11px] font-semibold rounded-md border border-gold-500/30">
      Bảo hành {product.warrantyYears} năm
    </span>
  </div>

  {/* Content */}
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between text-xs text-wood-500 mb-2">
        <span class="font-medium text-gold-600 uppercase tracking-wider">{product.categoryName}</span>
        <div class="flex items-center gap-1 text-amber-500 font-semibold">
          <span>★</span>
          <span>{product.rating}</span>
          <span class="text-wood-400 font-normal">({product.reviewCount})</span>
        </div>
      </div>

      <h3 class="text-base sm:text-lg font-serif font-bold text-wood-950 group-hover:text-gold-600 transition-colors line-clamp-2 mb-2">
        <a href={`/san-pham/${product.slug}`}>
          {product.name}
        </a>
      </h3>

      {/* Lỗ ban badge */}
      <div class="bg-red-50 border border-red-200/80 rounded-lg p-2.5 mb-3 text-xs text-red-800 space-y-1">
        <div class="flex items-center gap-1 font-bold">
          <span>📐</span>
          <span>Thước Lỗ Ban 38.8cm:</span>
        </div>
        <p class="text-[11px] leading-tight text-red-700">
          • Kích thước: <strong>{product.dimensions}</strong><br />
          • Cung Đỏ: <strong>{product.lobanInfo.depthCung}</strong> — <strong>{product.lobanInfo.widthCung}</strong>
        </p>
      </div>

      <p class="text-xs text-wood-600 line-clamp-2 mb-4">
        {product.description}
      </p>
    </div>

    {/* Price & Action */}
    <div class="pt-4 border-t border-wood-100">
      <div class="flex items-baseline justify-between mb-4">
        <div>
          <span class="text-lg sm:text-xl font-bold text-red-700 font-serif">
            {formatCurrency(product.price)}
          </span>
          <span class="text-xs text-wood-400 line-through ml-2">
            {formatCurrency(product.originalPrice)}
          </span>
        </div>
        <span class="text-[11px] font-bold text-green-700 bg-green-50 px-2 py-0.5 rounded border border-green-200">
          100% Gỗ Lõi
        </span>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <a
          href={`/san-pham/${product.slug}`}
          class="px-3 py-2 text-center text-xs font-semibold text-wood-800 bg-wood-100 hover:bg-wood-200 rounded-lg transition-colors"
        >
          Chi Tiết
        </a>
        <a
          href="https://zalo.me/0339533380"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2 text-center text-xs font-bold text-white bg-wood-900 hover:bg-wood-800 border border-gold-500/40 rounded-lg shadow-sm hover:shadow transition-all"
        >
          Nhận Clip Mộc
        </a>
      </div>
    </div>
  </div>
</div>
