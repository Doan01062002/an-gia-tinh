---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article' | 'product';
  schema?: Record<string, any>;
}

const {
  title = 'An Gia Tịnh — Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy Thước Lỗ Ban 38.8cm',
  description = 'An Gia Tịnh chuyên sản xuất bàn thờ treo chung cư, bàn thờ đứng gia tiên, tranh Trúc Chỉ sen LED. 100% gỗ tự nhiên tuyển chọn (Sồi Mỹ, Gõ Đỏ, Gụ Lào), chuẩn Thước Lỗ Ban 38.8cm, giao hàng toàn quốc.',
  image = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80',
  canonicalURL = Astro.url.href,
  type = 'website',
  schema,
} = Astro.props;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: 'An Gia Tịnh - Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy',
  description: description,
  url: 'https://an-gia-tinh.vercel.app',
  telephone: '+84339533380',
  priceRange: '1.200.000đ - 15.000.000đ',
  image: image,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Toàn quốc',
    addressLocality: 'Hà Nội',
    addressRegion: 'Việt Nam',
    postalCode: '100000',
    addressCountry: 'VN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 21.0285,
    longitude: 105.5842,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '07:30',
      closes: '21:30',
    },
  ],
};

const finalSchema = schema || defaultSchema;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="bàn thờ chung cư, bàn thờ treo tường, bàn thờ đứng gia tiên, thước lỗ ban 38.8, tranh trúc chỉ hoa sen, vách ngăn phòng thờ cnc, an gia tịnh, bàn thờ hiện đại" />
<meta name="author" content="An Gia Tịnh" />
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:locale" content="vi_VN" />
<meta property="og:site_name" content="An Gia Tịnh" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
