---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;

// Filter only h2 and h3
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="my-8 p-5 sm:p-7 bg-stone-50 rounded-2xl border border-stone-200 shadow-2xs" aria-label="Mục lục bài viết">
    <div class="flex items-center gap-2.5 pb-3 mb-4 border-b border-stone-200">
      <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-700 flex items-center justify-center">
        <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
        </svg>
      </div>
      <h3 class=" font-black text-sm sm:text-base text-stone-900 uppercase tracking-wider">
        Mục Lục Bài Viết (H2 & H3 Phân Cấp)
      </h3>
    </div>

    <ul class="space-y-1.5 text-xs sm:text-sm text-stone-700">
      {filteredHeadings.map((heading) => (
        <li class={
          heading.depth === 3 
            ? "ml-6 pl-3 border-l-2 border-amber-300 text-stone-600 text-xs py-0.5 hover:text-amber-800" 
            : "font-bold text-stone-900 pt-2 pb-0.5 flex items-center gap-1.5"
        }>
          {heading.depth === 2 && (
            <span class="w-1.5 h-1.5 rounded-full bg-amber-600 shrink-0"></span>
          )}
          <a
            href={`#${heading.slug}`}
            class="hover:text-amber-700 hover:underline transition-colors leading-relaxed"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
