---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import SpiritualHooks from '../components/SpiritualHooks';
import AIChatBot from '../components/AIChatBot';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  schema?: Record<string, any>;
}

const { title, description, image, type, schema } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      schema={schema}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FAFAF9] text-stone-900 antialiased selection:bg-amber-600 selection:text-white pb-16 md:pb-0">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* Floating spiritual hooks & mobile bottom sticky navigation bar */}
    <SpiritualHooks client:idle />

    {/* Anonymous AI Feng Shui Assistant Chatbot */}
    <AIChatBot client:idle />
  </body>
</html>
