---
import Layout from '../layouts/Layout.astro';
import ProductGallery from '../components/ProductGallery';
import LoBanTool from '../components/LoBanTool';
import FengShuiDirectionTool from '../components/FengShuiDirectionTool';
import { PRODUCTS } from '../data/products';
import { ARTICLES } from '../data/articles';

const completedProjects = [
  {
    apartment: 'Vinhomes Smart City Tây Mỗ',
    altar: 'Ban thờ treo Gỗ Sồi 48x81cm',
    image: '/images/completed/completed-smart-city.webp',
    tag: 'Căn hộ 2PN',
  },
  {
    apartment: 'Vinhomes Ocean Park Gia Lâm',
    altar: 'Combo Ban thờ Gõ Đỏ 48x89cm & Tranh Sen',
    image: '/images/completed/completed-ocean-park.webp',
    tag: 'Căn hộ 3PN',
  },
  {
    apartment: 'KĐT Vạn Phúc, TP. Thủ Đức',
    altar: 'Ban thờ đứng Gỗ Gụ Lào 61x107cm',
    image: '/images/completed/completed-van-phuc.webp',
    tag: 'Nhà phố',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: 'An Gia Tịnh - Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy',
  description: 'Trưng bày bộ sưu tập bàn thờ treo chung cư, bàn thờ đứng gia tiên chuẩn Thước Lỗ Ban 38.8cm. 100% gỗ lõi không rác, gửi video mộc 15s duyệt trước.',
  url: 'https://an-gia-tinh.vercel.app',
  telephone: '+84339533380',
  priceRange: '1.200.000đ - 15.000.000đ',
  image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80',
};
---

<Layout
  title="An Gia Tịnh — Bàn Thờ Hiện Đại Chuẩn Phong Thủy Lỗ Ban 38.8cm"
  description="Bộ sưu tập bàn thờ treo chung cư 48x81, 48x89cm, bàn thờ đứng gia tiên, tranh Trúc Chỉ sen LED. 100% gỗ tự nhiên tuyển chọn, chuẩn Thước Lỗ Ban 38.8cm, giao hàng toàn quốc."
  schema={homeSchema}
>
  {/* 1. Compact Promotional Banner Image */}
  <section class="max-w-6xl mx-auto px-2 sm:px-4 lg:px-8 pt-1.5 sm:pt-2">
    <div class="relative w-full overflow-hidden rounded-xl sm:rounded-2xl shadow-md border border-red-950/20 bg-[#660505] max-h-[180px] sm:max-h-[220px] md:max-h-[250px]">
      <img
        src="/banner-hero-an-gia-tinh.svg"
        alt="Ưu đãi ngập tràn bàn thờ chuẩn phong thủy Lỗ Ban An Gia Tịnh"
        class="w-full h-full object-cover block"
        loading="eager"
        fetchpriority="high"
        width="900"
        height="450"
      />
    </div>
  </section>

  {/* 2. MAIN PRODUCT GALLERY (Front & Center) */}
  <section id="bo-suu-tap" class="py-1.5 sm:py-4 bg-[#FAFAF9]">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
      {/* Interactive Mobile-Friendly Gallery */}
      <ProductGallery products={PRODUCTS} client:load />
    </div>
  </section>

  {/* 3. Lookbook Ảnh Thực Tế Bàn Giao */}
  <section class="py-8 sm:py-12 bg-white border-t border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-4">
        <div>
          <span class="text-[10px] font-bold text-amber-800 uppercase tracking-widest block">
            Thực Tế Căn Hộ
          </span>
          <h2 class="text-lg sm:text-2xl font-black text-stone-900 tracking-tight">
            Ảnh Lắp Đặt Tại Nhà Gia Chủ
          </h2>
        </div>
        <span class="text-[11px] text-stone-500 hidden sm:inline">Vinhomes & KĐT lớn</span>
      </div>

      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        {completedProjects.map((p) => (
          <div class="bg-stone-50 rounded-xl overflow-hidden border border-stone-200 shadow-2xs">
            <div class="aspect-square sm:aspect-4/3 overflow-hidden bg-stone-100">
              <img
                src={p.image}
                alt={p.apartment}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-2 sm:p-3">
              <span class="text-[9px] sm:text-[10px] font-bold text-amber-800 block truncate">
                {p.apartment}
              </span>
              <p class="text-[10px] sm:text-xs text-stone-700 truncate font-medium">
                {p.altar}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. Bộ Tiện Ích Phong Thủy: Thước Lỗ Ban 38.8cm & Tra Hướng Đặt Ban Thờ Theo Tuổi */}
  <section class="py-8 sm:py-12 bg-white space-y-10 border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-lg sm:text-2xl font-black text-stone-900 tracking-tight">
          Tra Cứu Thước Lỗ Ban 38.8cm
        </h2>
        <p class="text-[11px] sm:text-xs text-stone-600 font-light mt-0.5">
          Kéo thước hoặc nhập kích thước (cm) để kiểm tra Cung Đỏ (Cát Tường).
        </p>
      </div>

      <LoBanTool client:load />
    </div>

    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <FengShuiDirectionTool client:load />
    </div>
  </section>

  {/* 5. Cẩm Nang & Blog Phong Thủy Thờ Cúng (Ngay Trên Đoạn Footer) */}
  <section class="py-10 sm:py-16 bg-[#FAFAF9]">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3">
        <div>
          <span class="text-[10px] sm:text-xs font-bold text-amber-800 uppercase tracking-widest block mb-1">
            Cẩm Nang Thờ Cúng
          </span>
          <h2 class="text-xl sm:text-3xl font-black text-stone-900 tracking-tight">
            Kiến Thức Phong Thủy & Không Gian Thờ
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 font-light mt-1 max-w-xl">
            Tổng hợp bài văn khấn an vị, kinh nghiệm tra Thước Lỗ Ban 38.8cm và cẩm nang lựa chọn gỗ tự nhiên bền đẹp.
          </p>
        </div>
        <a
          href="/kien-thuc"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-amber-800 hover:text-amber-900 group shrink-0"
        >
          <span>Xem tất cả bài viết</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
        {ARTICLES.slice(0, 3).map((article) => (
          <article class="bg-white rounded-2xl overflow-hidden border border-stone-200/90 shadow-2xs hover:shadow-lg hover:border-amber-700/30 transition-all duration-300 flex flex-col group">
            <div class="aspect-16/9 overflow-hidden bg-stone-100 relative">
              <img
                src={article.coverImage}
                alt={article.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-[#451a03]/85 backdrop-blur-xs text-amber-200 text-[10px] font-bold shadow-xs">
                {article.category}
              </span>
            </div>
            <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-[11px] text-stone-500 mb-2">
                  <span>{article.readingTime}</span>
                  <span class="text-stone-300">•</span>
                  <span>{article.publishDate}</span>
                </div>

                <h3 class="text-sm sm:text-base font-bold text-stone-900 group-hover:text-amber-800 transition-colors line-clamp-2 leading-snug mb-2">
                  <a href={`/kien-thuc/${article.slug}`}>
                    {article.title}
                  </a>
                </h3>

                <p class="text-xs text-stone-600 line-clamp-2 font-light leading-relaxed mb-4">
                  {article.description}
                </p>
              </div>

              <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-xs">
                <span class="text-stone-500 text-[11px] font-medium truncate max-w-[150px]">
                  {article.author.split('(')[0].trim()}
                </span>
                <a
                  href={`/kien-thuc/${article.slug}`}
                  class="font-bold text-amber-800 hover:text-amber-900 flex items-center gap-1 group/btn"
                >
                  <span>Đọc tiếp</span>
                  <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
