---
import Layout from '../layouts/Layout.astro';
import ProductGallery from '../components/ProductGallery';
import LoBanTool from '../components/LoBanTool';
import FengShuiDirectionTool from '../components/FengShuiDirectionTool';
import { PRODUCTS } from '../data/products';

const completedProjects = [
  {
    apartment: 'Vinhomes Smart City Tây Mỗ',
    altar: 'Ban thờ treo Gỗ Sồi 48x81cm',
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80',
    tag: 'Căn hộ 2PN',
  },
  {
    apartment: 'Vinhomes Ocean Park Gia Lâm',
    altar: 'Combo Ban thờ Gõ Đỏ 48x89cm & Tranh Sen',
    image: 'https://images.unsplash.com/photo-1540518614846-7ede433c4ef4?auto=format&fit=crop&w=800&q=80',
    tag: 'Căn hộ 3PN',
  },
  {
    apartment: 'KĐT Vạn Phúc, TP. Thủ Đức',
    altar: 'Ban thờ đứng Gỗ Gụ Lào 61x107cm',
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80',
    tag: 'Nhà phố',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: 'An Gia Tịnh - Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy',
  description: 'Trưng bày bộ sưu tập bàn thờ treo chung cư, bàn thờ đứng gia tiên chuẩn Thước Lỗ Ban 38.8cm. 100% gỗ lõi không rác, gửi video mộc 15s duyệt trước.',
  url: 'https://an-gia-tinh.vercel.app',
  telephone: '+84339533380',
  priceRange: '1.200.000đ - 15.000.000đ',
  image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80',
};
---

<Layout
  title="An Gia Tịnh — Bàn Thờ Hiện Đại Chuẩn Phong Thủy Lỗ Ban 38.8cm"
  description="Bộ sưu tập bàn thờ treo chung cư 48x81, 48x89cm, bàn thờ đứng gia tiên, tranh Trúc Chỉ sen LED. 100% gỗ lõi không rác, duyệt clip mộc 15s trước khi nhận hàng."
  schema={homeSchema}
>
  {/* 1. Festive Promotional Hero Banner (Exact Tâm Phát Reference) */}
  <section class="relative bg-gradient-to-b from-[#7A0D0D] via-[#941313] to-[#630707] text-white py-6 sm:py-10 lg:py-14 border-b border-red-950 overflow-hidden shadow-inner">
    {/* Festive Gold Sparkle Ambient Background */}
    <div class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px]"></div>

    <div class="max-w-5xl mx-auto px-3.5 sm:px-6 lg:px-8 relative z-10 text-center">
      {/* Small Top Badge */}
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/30 border border-amber-400/40 text-amber-300 text-[11px] font-bold tracking-wide uppercase mb-2 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Xưởng Mộc Làng Nghề Sơn Đồng & Canh Nậu</span>
      </div>

      {/* Cursive Subtitle */}
      <p class="font-serif italic text-amber-200 text-sm sm:text-lg tracking-wide mb-1 font-medium">
        Khai Xuân Rộn Ràng — An Gia Đón Lộc
      </p>

      {/* Main Uppercase Headline */}
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white uppercase leading-tight drop-shadow-md mb-5 sm:mb-8">
        ƯU ĐÃI NGẬP TRÀN <br />
        <span class="text-amber-300">ĐỒ THỜ CHUẨN LỖ BAN 38.8CM</span>
      </h1>

      {/* 3 Featured Altar Setup Showcases in Golden Frames (Like Image 1) */}
      <div class="grid grid-cols-3 gap-2 sm:gap-4 max-w-xl mx-auto mb-6 sm:mb-8">
        <div class="group relative rounded-xl sm:rounded-2xl overflow-hidden border-2 border-amber-400/80 p-0.5 sm:p-1 bg-amber-900/40 shadow-lg">
          <div class="aspect-square rounded-lg sm:rounded-xl overflow-hidden bg-black/40">
            <img
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=400&q=80"
              alt="Bàn thờ treo chung cư"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <span class="block text-[9px] sm:text-[11px] font-bold text-amber-200 mt-1 truncate px-1">
            Ban Treo 48x81cm
          </span>
        </div>

        <div class="group relative rounded-xl sm:rounded-2xl overflow-hidden border-2 border-amber-400 p-0.5 sm:p-1 bg-amber-900/40 shadow-xl scale-105 -translate-y-1">
          <div class="aspect-square rounded-lg sm:rounded-xl overflow-hidden bg-black/40">
            <img
              src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=400&q=80"
              alt="Tranh Trúc Chỉ Sen LED"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <span class="block text-[9px] sm:text-[11px] font-black text-amber-300 mt-1 truncate px-1">
            Tranh Sen LED Hào Quang
          </span>
        </div>

        <div class="group relative rounded-xl sm:rounded-2xl overflow-hidden border-2 border-amber-400/80 p-0.5 sm:p-1 bg-amber-900/40 shadow-lg">
          <div class="aspect-square rounded-lg sm:rounded-xl overflow-hidden bg-black/40">
            <img
              src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=400&q=80"
              alt="Bàn thờ đứng gia tiên"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <span class="block text-[9px] sm:text-[11px] font-bold text-amber-200 mt-1 truncate px-1">
            Ban Đứng Kèm Tủ
          </span>
        </div>
      </div>

      {/* 3 Promotional Badges in Gold/Cream Cards (Exact Tâm Phát Layout) */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 max-w-3xl mx-auto mb-6">
        <div class="bg-gradient-to-br from-[#FFF8E7] to-[#FDE8B5] text-stone-900 p-3 rounded-xl border-2 border-amber-400 shadow-md">
          <span class="block text-[11px] uppercase tracking-wider font-bold text-amber-950">
            QUÀ TẶNG TRỊ GIÁ
          </span>
          <span class="block text-xl sm:text-2xl font-black text-[#8B0000] my-0.5">
            500.000₫
          </span>
          <span class="block text-[10px] text-stone-700 font-medium">
            Trọn bộ văn khấn an vị & bao sái gia tiên
          </span>
        </div>

        <div class="bg-gradient-to-br from-[#FFF8E7] to-[#FDE8B5] text-stone-900 p-3 rounded-xl border-2 border-amber-400 shadow-md">
          <span class="block text-[11px] uppercase tracking-wider font-bold text-amber-950">
            GIẢM GIÁ ĐẾN
          </span>
          <span class="block text-2xl sm:text-3xl font-black text-[#8B0000] my-0.5">
            30%
          </span>
          <span class="block text-[10px] text-stone-700 font-medium">
            Giá gốc xưởng mộc 0đ không qua trung gian
          </span>
        </div>

        <div class="bg-gradient-to-br from-[#FFF8E7] to-[#FDE8B5] text-stone-900 p-3 rounded-xl border-2 border-amber-400 shadow-md">
          <span class="block text-[11px] uppercase tracking-wider font-bold text-amber-950">
            MIỄN PHÍ GIAO HÀNG
          </span>
          <span class="block text-base sm:text-lg font-black text-[#8B0000] my-0.5 leading-tight">
            CLIP MỘC 15S
          </span>
          <span class="block text-[10px] text-stone-700 font-medium">
            100% Gỗ lõi không rác (Đền bù 200%)
          </span>
        </div>
      </div>

      {/* CTA Row */}
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/thuoc-lo-ban"
          class="px-5 py-2.5 bg-amber-400 hover:bg-amber-300 text-stone-950 font-bold text-xs sm:text-sm rounded-full shadow-lg transition-all hover:scale-105"
        >
          Tra Thước Lỗ Ban 38.8cm Online →
        </a>

        <a
          href="https://zalo.me/0339533380?text=Toi%20muon%20nhan%20uu%20dai%20qua%20tang%20va%20clip%20moc%2015s"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 bg-black/40 hover:bg-black/60 text-white border border-amber-300/60 font-bold text-xs sm:text-sm rounded-full transition-all"
        >
          Nhắn Zalo Nhận Clip Mộc 15s
        </a>
      </div>
    </div>
  </section>

  {/* 2. MAIN PRODUCT GALLERY (Front & Center) */}
  <section id="bo-suu-tap" class="py-6 sm:py-10 bg-[#FAFAF9]">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
      {/* Interactive Mobile-Friendly Gallery */}
      <ProductGallery products={PRODUCTS} client:load />
    </div>
  </section>

  {/* 3. Lookbook Ảnh Thực Tế Bàn Giao */}
  <section class="py-8 sm:py-12 bg-white border-t border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-4">
        <div>
          <span class="text-[10px] font-bold text-amber-800 uppercase tracking-widest block">
            Thực Tế Căn Hộ
          </span>
          <h2 class="text-lg sm:text-2xl font-serif font-black text-stone-900">
            Ảnh Lắp Đặt Tại Nhà Gia Chủ
          </h2>
        </div>
        <span class="text-[11px] text-stone-500 hidden sm:inline">Vinhomes & KĐT lớn</span>
      </div>

      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        {completedProjects.map((p) => (
          <div class="bg-stone-50 rounded-xl overflow-hidden border border-stone-200 shadow-2xs">
            <div class="aspect-square sm:aspect-4/3 overflow-hidden bg-stone-100">
              <img
                src={p.image}
                alt={p.apartment}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-2 sm:p-3">
              <span class="text-[9px] sm:text-[10px] font-bold text-amber-800 block truncate">
                {p.apartment}
              </span>
              <p class="text-[10px] sm:text-xs text-stone-700 truncate font-medium">
                {p.altar}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. Quy Trình 3 Bước Mua Hàng An Toàn */}
  <section class="py-8 sm:py-12 bg-[#FAFAF9] border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-lg sm:text-2xl font-serif font-black text-stone-900">
          3 Bước Đặt Bàn Thờ Chuẩn Phong Thủy
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-2xs space-y-1">
          <span class="w-6 h-6 rounded-md bg-amber-500/15 text-amber-800 font-serif font-black text-xs flex items-center justify-center">
            01
          </span>
          <h3 class="font-bold text-xs sm:text-sm text-stone-900">Chọn Kích Thước Lỗ Ban</h3>
          <p class="text-[11px] text-stone-600 font-light">
            Chọn mẫu 48x81, 48x89cm chuẩn Cung Đỏ Hỷ Sự, Thêm Phúc.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-2xs space-y-1">
          <span class="w-6 h-6 rounded-md bg-amber-500/15 text-amber-800 font-serif font-black text-xs flex items-center justify-center">
            02
          </span>
          <h3 class="font-bold text-xs sm:text-sm text-stone-900">Duyệt Video Mộc 15s</h3>
          <p class="text-[11px] text-stone-600 font-light">
            Xưởng quay cận cảnh thớ vân mộc thô gửi Zalo trước khi phun sơn.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-2xs space-y-1">
          <span class="w-6 h-6 rounded-md bg-amber-500/15 text-amber-800 font-serif font-black text-xs flex items-center justify-center">
            03
          </span>
          <h3 class="font-bold text-xs sm:text-sm text-stone-900">Giao COD Toàn Quốc</h3>
          <p class="text-[11px] text-stone-600 font-light">
            Giao tận nhà. Gia chủ bóc hộp kiểm tra gỗ lõi mới thanh toán.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 5. Bộ Tiện Ích Phong Thủy: Thước Lỗ Ban 38.8cm & Tra Hướng Đặt Ban Thờ Theo Tuổi */}
  <section class="py-8 sm:py-12 bg-white space-y-10">
    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-lg sm:text-2xl font-serif font-black text-stone-900">
          Tra Cứu Thước Lỗ Ban 38.8cm
        </h2>
        <p class="text-[11px] sm:text-xs text-stone-600 font-light mt-0.5">
          Kéo thước hoặc nhập kích thước (cm) để kiểm tra Cung Đỏ (Cát Tường).
        </p>
      </div>

      <LoBanTool client:load />
    </div>

    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <FengShuiDirectionTool client:load />
    </div>
  </section>
</Layout>
