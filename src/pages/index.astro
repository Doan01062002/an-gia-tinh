        <div class="p-8 rounded-3xl bg-[#26150D] border border-[#3E2416] space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#CFA439]/20 text-[#E2BE5F] flex items-center justify-center font-serif font-black text-xl">
