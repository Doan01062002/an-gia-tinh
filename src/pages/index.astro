---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import LoBanTool from '../components/LoBanTool';
import { PRODUCTS } from '../data/products';

const featuredProducts = PRODUCTS.slice(0, 4);

const faqList = [
  {
    q: 'Vì sao bàn thờ của An Gia Tịnh cam kết 100% gỗ lõi không rác và đền bù 200%?',
    a: 'Trong tâm linh thờ cúng gia tiên, gỗ rác (phần dác gỗ xốp bên ngoài thân cây) là đại kỵ vì rất nhanh bị mối mọt đục khoét, cong vênh và nứt toác. An Gia Tịnh chỉ sử dụng phần gỗ lõi đanh chắc nhất (Gỗ Sồi Mỹ, Gõ Đỏ Pachy, Gụ Lào), xẻ sấy đạt ẩm độ 10-12% và sẵn sàng quay clip mộc 15s soi thớ vân trước khi hoàn thiện. Nếu phát hiện pha gỗ rác, xưởng cam kết đền bù 200% giá trị đơn hàng.',
  },
  {
    q: 'Thước Lỗ Ban 38.8cm có vai trò gì khi chọn bàn thờ cho căn hộ chung cư?',
    a: 'Thước Lỗ Ban 38.8cm (còn gọi là Thước Âm Phần) là thước chuẩn phong thủy dùng riêng cho việc đóng bàn thờ, mồ mả và đồ thờ cúng. Mọi kích thước ngang, sâu, cao tại An Gia Tịnh đều được tính toán chuẩn xác rơi vào các Cung Đỏ đại cát như: Hỷ Sự, Đăng Khoa, Tiến Bảo, Thêm Đinh, Lục Hợp, giúp gia đạo bình an và tài lộc dồi dào.',
  },
  {
    q: 'Tôi ở xa thì kiểm tra sản phẩm và thanh toán như thế nào?',
    a: 'Trước khi đóng gói, xưởng sẽ quay 1 video cận cảnh thớ mộc thô 15s gửi qua Zalo để gia chủ duyệt thớ gỗ và mộng đục. Sau khi gia chủ ưng ý, xưởng đóng gói xốp nổ 3 lớp bọc bìa carton gửi COD tận nhà. Gia chủ nhận hàng, bóc ra kiểm tra đúng chất gỗ và kích thước mới thanh toán.',
  },
  {
    q: 'Bàn thờ treo tường chung cư có bắt chắc chắn vào tường không, chịu tải được bao nhiêu kg?',
    a: 'Chân thang bàn thờ treo của An Gia Tịnh được gia cố mộng thắt đục sâu vào thân gỗ và sử dụng vít nở bê tông chịu lực chuyên dụng, đảm bảo chịu tải an toàn từ 40kg đến 50kg, bày biện mâm cúng hoa quả thoải mái không lo rung lắc.',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: 'An Gia Tịnh - Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy',
  description: 'Xưởng mộc chuyên phân phối bàn thờ treo chung cư, bàn thờ đứng gia tiên chuẩn Thước Lỗ Ban 38.8cm Cung Đỏ. Cam kết 100% gỗ lõi không rác, đền bù 200%.',
  url: 'https://an-gia-tinh.vercel.app',
  telephone: '+84339533380',
  priceRange: '1.200.000đ - 15.000.000đ',
  image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Làng nghề mộc Canh Nậu, Thạch Thất',
    addressLocality: 'Hà Nội',
    addressRegion: 'Hà Nội',
    postalCode: '100000',
    addressCountry: 'VN',
  },
  mainEntity: faqList.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<Layout
  title="An Gia Tịnh — Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy Thước Lỗ Ban 38.8cm"
  description="Xưởng mộc An Gia Tịnh sản xuất bàn thờ treo chung cư, bàn thờ đứng gia tiên, tranh Trúc Chỉ sen LED. 100% gỗ lõi không rác (Sồi Mỹ, Gõ Đỏ, Gụ Lào), chuẩn Thước Lỗ Ban 38.8cm, gửi video mộc 15s duyệt trước khi giao."
  schema={homeSchema}
>
  {/* Hero Banner Section */}
  <section class="relative bg-gradient-to-b from-wood-950 via-wood-900 to-wood-950 text-white overflow-hidden py-16 sm:py-24 border-b-4 border-gold-500">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:24px_24px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        {/* Left column: Copy & CTAs */}
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-wood-800/80 border border-gold-500/40 text-gold-300 text-xs sm:text-sm font-medium shadow-inner">
            <span>🪷</span>
            <span>Tinh Hoa Đồ Thờ Làng Nghề Canh Nậu & Sơn Đồng</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-black tracking-tight leading-tight sm:leading-tight">
            Trọn Vẹn Tâm Linh <br />
            <span class="gold-text">Bình An Gia Đạo</span>
          </h1>

          <p class="text-wood-200 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            Chuyên gia sản xuất bàn thờ treo chung cư và bàn thờ đứng gia tiên hiện đại. Tuyệt đối <strong>100% Gỗ Lõi Tự Nhiên Không Rác</strong> (Đền bù 200%), kích thước chuẩn phong thủy <strong>Thước Lỗ Ban 38.8cm Cung Đỏ</strong>, quay clip mộc 15s duyệt thớ vân trước khi đóng gói gửi COD toàn quốc.
          </p>

          {/* Quick value tags */}
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-left">
            <div class="p-3 rounded-xl bg-wood-900/60 border border-gold-500/20">
              <span class="text-gold-400 font-bold block text-sm">🪵 100% Gỗ Lõi</span>
              <span class="text-wood-300 text-xs">Không dính rác (Đền 200%)</span>
            </div>
            <div class="p-3 rounded-xl bg-wood-900/60 border border-gold-500/20">
              <span class="text-gold-400 font-bold block text-sm">📐 Lỗ Ban 38.8cm</span>
              <span class="text-wood-300 text-xs">Cặp cung đỏ cát tường</span>
            </div>
            <div class="p-3 rounded-xl bg-wood-900/60 border border-gold-500/20 col-span-2 sm:col-span-1">
              <span class="text-gold-400 font-bold block text-sm">🎥 Clip Mộc 15s</span>
              <span class="text-wood-300 text-xs">Xem vân trước khi sơn</span>
            </div>
          </div>

          {/* CTAs */}
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
            <a
              href="/san-pham"
              class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:from-gold-500 hover:to-gold-700 text-wood-950 font-bold text-base rounded-xl shadow-xl hover:shadow-gold-500/30 transition-all text-center"
            >
              Xem Bộ Sưu Tập Bàn Thờ
            </a>
            <a
              href="/thuoc-lo-ban"
              class="w-full sm:w-auto px-6 py-4 bg-wood-800/80 hover:bg-wood-800 text-white font-semibold text-base rounded-xl border border-gold-500/40 hover:border-gold-400 transition-all text-center flex items-center justify-center gap-2"
            >
              <span>📐 Tra Cứu Lỗ Ban</span>
            </a>
          </div>
        </div>

        {/* Right column: Hero image with trust badge */}
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none rounded-2xl overflow-hidden shadow-2xl border-2 border-gold-500/40">
            <img
              src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80"
              alt="Không gian phòng thờ chung cư hiện đại An Gia Tịnh"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-wood-950/90 via-transparent to-transparent"></div>

            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-wood-900/90 backdrop-blur-md border border-gold-500/30 text-xs text-wood-200">
              <div class="flex items-center gap-2 text-gold-300 font-bold text-sm mb-1">
                <span>⭐</span>
                <span>Combo Phòng Thờ Chung Cư Cao Cấp</span>
              </div>
              <p>Bàn thờ treo gỗ Gõ Đỏ 48x89cm kết hợp Tranh Trúc Chỉ hoa sen đèn LED hào quang vàng ấm.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Value Pillars Section */}
  <section class="py-12 bg-white border-b border-wood-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl bg-wood-50 border border-wood-200/80 hover:border-gold-500/60 transition-all">
          <div class="w-12 h-12 rounded-xl bg-gold-400/20 text-gold-600 flex items-center justify-center text-2xl mb-4">
            🪵
          </div>
          <h3 class="font-serif font-bold text-lg text-wood-950 mb-2">100% Gỗ Lõi Thật</h3>
          <p class="text-xs sm:text-sm text-wood-600 leading-relaxed">
            Tuyệt đối không pha dác rác. Xẻ sấy lò công nghiệp 25-35 ngày đạt chuẩn ẩm độ 10-12%, không lo mối mọt, cong vênh.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-wood-50 border border-wood-200/80 hover:border-gold-500/60 transition-all">
          <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center text-2xl mb-4">
            📐
          </div>
          <h3 class="font-serif font-bold text-lg text-wood-950 mb-2">Chuẩn Lỗ Ban 38.8cm</h3>
          <p class="text-xs sm:text-sm text-wood-600 leading-relaxed">
            Mọi số đo ngang, sâu, cao đều được thợ cả làng nghề cắt trúng cung đỏ cát tường: Đăng Khoa, Thêm Phúc, Tiến Bảo.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-wood-50 border border-wood-200/80 hover:border-gold-500/60 transition-all">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-2xl mb-4">
            🎥
          </div>
          <h3 class="font-serif font-bold text-lg text-wood-950 mb-2">Duyệt Video Mộc 15s</h3>
          <p class="text-xs sm:text-sm text-wood-600 leading-relaxed">
            Xem cận cảnh vân gỗ mộc thô trước khi phun sơn. Ưng ý thớ mộc mới tiến hành sơn bóng mờ Inchem cao cấp.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-wood-50 border border-wood-200/80 hover:border-gold-500/60 transition-all">
          <div class="w-12 h-12 rounded-xl bg-green-100 text-green-600 flex items-center justify-center text-2xl mb-4">
            🚚
          </div>
          <h3 class="font-serif font-bold text-lg text-wood-950 mb-2">Giao Toàn Quốc COD</h3>
          <p class="text-xs sm:text-sm text-wood-600 leading-relaxed">
            Đóng thùng xốp nổ bọc bìa carton dày dặn. Giao tận nhà, gia chủ bóc kiểm tra đúng mẫu đúng gỗ mới thanh toán.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Interactive Lỗ Ban Tool Section directly on Home */}
  <section class="py-16 sm:py-20 bg-wood-50 border-b border-wood-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block px-3 py-1 bg-red-100 text-red-800 text-xs font-bold rounded-full uppercase tracking-wider mb-2">
          Tiện Ích Phong Thủy Độc Quyền
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif font-bold text-wood-950">
          Tra Cứu Kích Thước Bàn Thờ Hợp Tuổi Gia Chủ
        </h2>
        <p class="text-sm sm:text-base text-wood-600 mt-2 max-w-xl mx-auto">
          Ứng dụng thuật toán Thước Lỗ Ban 38.8cm truyền thống giúp gia chủ nhanh chóng xác định kích thước cát lành nhất cho không gian thờ.
        </p>
      </div>

      <LoBanTool client:load />
    </div>
  </section>

  {/* Featured Products Section */}
  <section class="py-16 sm:py-24 bg-white border-b border-wood-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <span class="text-xs font-bold text-gold-600 uppercase tracking-widest block mb-2">
            Mẫu Bàn Thờ Được Ưa Chuộng Nhất
          </span>
          <h2 class="text-2xl sm:text-4xl font-serif font-bold text-wood-950">
            Tuyển Tập Bàn Thờ Chung Cư & Gia Tiên
          </h2>
        </div>
        <a
          href="/san-pham"
          class="inline-flex items-center gap-2 text-sm font-bold text-gold-600 hover:text-wood-900 transition-colors"
        >
          <span>Xem tất cả mẫu bàn thờ & phụ kiện</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  {/* Craftsmanship Breakdown: Traditional Mortise & Tenon vs Cheap Nails */}
  <section class="py-16 sm:py-20 bg-gradient-to-br from-wood-900 via-wood-950 to-wood-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-gold-400 uppercase tracking-widest block mb-2">
          Quy Chuẩn Chế Tác Nghề Mộc
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif font-bold text-white">
          Sự Khác Biệt Giữa Mộc Làng Nghề & Hàng Chợ Bắn Đinh
        </h2>
        <p class="text-wood-300 text-xs sm:text-sm mt-3">
          Tại sao bàn thờ của An Gia Tịnh có thể bền đẹp 20-30 năm không xộc xệch hay nứt nẻ?
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-wood-800/60 border border-gold-500/20 space-y-3">
          <div class="text-3xl text-gold-400 font-serif font-black">01</div>
          <h3 class="font-serif font-bold text-lg text-white">Kết Cấu Mộng Đục Thắt Thủ Công</h3>
          <p class="text-xs sm:text-sm text-wood-300 leading-relaxed">
            Tuyệt đối không bắn đinh kim loại trên mặt ban thờ gia tiên (đại kỵ phong thủy hàn khí). Mọi mối nối được khớp bằng mộng én, mộng mang cá truyền thống khít khao, càng dùng lâu gỗ càng đanh chắc.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-wood-800/60 border border-gold-500/20 space-y-3">
          <div class="text-3xl text-gold-400 font-serif font-black">02</div>
          <h3 class="font-serif font-bold text-lg text-white">Công Nghệ Sấy Lò Hạ Ẩm 10-12%</h3>
          <p class="text-xs sm:text-sm text-wood-300 leading-relaxed">
            Gỗ thô được đưa vào lò sấy nhiệt điện tử trong 25 đến 35 ngày. Độ ẩm được kiểm soát ở mức 10-12%, triệt tiêu hoàn toàn hiện tượng co ngót, nứt nẻ khi gặp mùa nồm ẩm miền Bắc hay máy lạnh căn hộ.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-wood-800/60 border border-gold-500/20 space-y-3">
          <div class="text-3xl text-gold-400 font-serif font-black">03</div>
          <h3 class="font-serif font-bold text-lg text-white">Sơn Lụa Inchem 5 Lớp Bóng Mờ</h3>
          <p class="text-xs sm:text-sm text-wood-300 leading-relaxed">
            Sử dụng sơn Inchem nhập khẩu cao cấp, phủ 5 lớp bảo vệ chống trầy xước và tàn nhang rơi rớt nhưng vẫn giữ được độ ấm áp, tự nhiên khi sờ tay vào từng đường vân gỗ thịt.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ Section */}
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-gold-600 uppercase tracking-widest block mb-2">
          Giải Đáp Thắc Mắc Gia Chủ
        </span>
        <h2 class="text-2xl sm:text-4xl font-serif font-bold text-wood-950">
          Câu Hỏi Thường Gặp Về Bàn Thờ & Phong Thủy
        </h2>
      </div>

      <div class="space-y-4">
        {faqList.map((item, idx) => (
          <div class="p-6 rounded-2xl bg-wood-50 border border-wood-200/80">
            <h3 class="font-serif font-bold text-base sm:text-lg text-wood-950 mb-2 flex items-start gap-3">
              <span class="text-gold-600 font-mono font-bold">Q{idx + 1}.</span>
              <span>{item.q}</span>
            </h3>
            <p class="text-xs sm:text-sm text-wood-700 leading-relaxed pl-8">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
