---
import Layout from '../layouts/Layout.astro';
import ProductGallery from '../components/ProductGallery';
import LoBanTool from '../components/LoBanTool';
import FengShuiDirectionTool from '../components/FengShuiDirectionTool';
import { PRODUCTS } from '../data/products';

const completedProjects = [
  {
    apartment: 'Vinhomes Smart City Tây Mỗ',
    altar: 'Ban thờ treo Gỗ Sồi 48x81cm',
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80',
    tag: 'Căn hộ 2PN',
  },
  {
    apartment: 'Vinhomes Ocean Park Gia Lâm',
    altar: 'Combo Ban thờ Gõ Đỏ 48x89cm & Tranh Sen',
    image: 'https://images.unsplash.com/photo-1540518614846-7ede433c4ef4?auto=format&fit=crop&w=800&q=80',
    tag: 'Căn hộ 3PN',
  },
  {
    apartment: 'KĐT Vạn Phúc, TP. Thủ Đức',
    altar: 'Ban thờ đứng Gỗ Gụ Lào 61x107cm',
    image: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=800&q=80',
    tag: 'Nhà phố',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: 'An Gia Tịnh - Bàn Thờ Hiện Đại & Không Gian Thờ Chuẩn Phong Thủy',
  description: 'Trưng bày bộ sưu tập bàn thờ treo chung cư, bàn thờ đứng gia tiên chuẩn Thước Lỗ Ban 38.8cm. 100% gỗ lõi không rác, gửi video mộc 15s duyệt trước.',
  url: 'https://an-gia-tinh.vercel.app',
  telephone: '+84339533380',
  priceRange: '1.200.000đ - 15.000.000đ',
  image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80',
};
---

<Layout
  title="An Gia Tịnh — Bàn Thờ Hiện Đại Chuẩn Phong Thủy Lỗ Ban 38.8cm"
  description="Bộ sưu tập bàn thờ treo chung cư 48x81, 48x89cm, bàn thờ đứng gia tiên, tranh Trúc Chỉ sen LED. 100% gỗ lõi không rác, duyệt clip mộc 15s trước khi nhận hàng."
  schema={homeSchema}
>
  {/* 1. Compact Promotional Banner Image (Exact Tâm Phát Layout: 35% Hero / 65% Immediate Products) */}
  <section class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8 pt-2 sm:pt-3">
    <div class="relative w-full overflow-hidden rounded-xl sm:rounded-2xl shadow-md border border-red-950/20 bg-[#660505]">
      <img
        src="/banner-hero-an-gia-tinh.svg"
        alt="Ưu đãi ngập tràn bàn thờ chuẩn phong thủy Lỗ Ban An Gia Tịnh"
        class="w-full h-auto aspect-[2/1] sm:aspect-[2.3/1] md:aspect-[2.5/1] object-cover block"
        loading="eager"
        fetchpriority="high"
        width="900"
        height="450"
      />
    </div>
  </section>

  {/* 2. MAIN PRODUCT GALLERY (Front & Center) */}
  <section id="bo-suu-tap" class="py-2.5 sm:py-8 bg-[#FAFAF9]">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
      {/* Interactive Mobile-Friendly Gallery */}
      <ProductGallery products={PRODUCTS} client:load />
    </div>
  </section>

  {/* 3. Lookbook Ảnh Thực Tế Bàn Giao */}
  <section class="py-8 sm:py-12 bg-white border-t border-b border-stone-200">
    <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-4">
        <div>
          <span class="text-[10px] font-bold text-amber-800 uppercase tracking-widest block">
            Thực Tế Căn Hộ
          </span>
          <h2 class="text-lg sm:text-2xl font-serif font-black text-stone-900">
            Ảnh Lắp Đặt Tại Nhà Gia Chủ
          </h2>
        </div>
        <span class="text-[11px] text-stone-500 hidden sm:inline">Vinhomes & KĐT lớn</span>
      </div>

      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        {completedProjects.map((p) => (
          <div class="bg-stone-50 rounded-xl overflow-hidden border border-stone-200 shadow-2xs">
            <div class="aspect-square sm:aspect-4/3 overflow-hidden bg-stone-100">
              <img
                src={p.image}
                alt={p.apartment}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-2 sm:p-3">
              <span class="text-[9px] sm:text-[10px] font-bold text-amber-800 block truncate">
                {p.apartment}
              </span>
              <p class="text-[10px] sm:text-xs text-stone-700 truncate font-medium">
                {p.altar}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. Quy Trình 3 Bước Mua Hàng An Toàn */}
  <section class="py-8 sm:py-12 bg-[#FAFAF9] border-b border-stone-200">
    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-lg sm:text-2xl font-serif font-black text-stone-900">
          3 Bước Đặt Bàn Thờ Chuẩn Phong Thủy
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-2xs space-y-1">
          <span class="w-6 h-6 rounded-md bg-amber-500/15 text-amber-800 font-serif font-black text-xs flex items-center justify-center">
            01
          </span>
          <h3 class="font-bold text-xs sm:text-sm text-stone-900">Chọn Kích Thước Lỗ Ban</h3>
          <p class="text-[11px] text-stone-600 font-light">
            Chọn mẫu 48x81, 48x89cm chuẩn Cung Đỏ Hỷ Sự, Thêm Phúc.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-2xs space-y-1">
          <span class="w-6 h-6 rounded-md bg-amber-500/15 text-amber-800 font-serif font-black text-xs flex items-center justify-center">
            02
          </span>
          <h3 class="font-bold text-xs sm:text-sm text-stone-900">Duyệt Video Mộc 15s</h3>
          <p class="text-[11px] text-stone-600 font-light">
            Xưởng quay cận cảnh thớ vân mộc thô gửi Zalo trước khi phun sơn.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-stone-200 shadow-2xs space-y-1">
          <span class="w-6 h-6 rounded-md bg-amber-500/15 text-amber-800 font-serif font-black text-xs flex items-center justify-center">
            03
          </span>
          <h3 class="font-bold text-xs sm:text-sm text-stone-900">Giao COD Toàn Quốc</h3>
          <p class="text-[11px] text-stone-600 font-light">
            Giao tận nhà. Gia chủ bóc hộp kiểm tra gỗ lõi mới thanh toán.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 5. Bộ Tiện Ích Phong Thủy: Thước Lỗ Ban 38.8cm & Tra Hướng Đặt Ban Thờ Theo Tuổi */}
  <section class="py-8 sm:py-12 bg-white space-y-10">
    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-lg sm:text-2xl font-serif font-black text-stone-900">
          Tra Cứu Thước Lỗ Ban 38.8cm
        </h2>
        <p class="text-[11px] sm:text-xs text-stone-600 font-light mt-0.5">
          Kéo thước hoặc nhập kích thước (cm) để kiểm tra Cung Đỏ (Cát Tường).
        </p>
      </div>

      <LoBanTool client:load />
    </div>

    <div class="max-w-4xl mx-auto px-3.5 sm:px-6 lg:px-8">
      <FengShuiDirectionTool client:load />
    </div>
  </section>
</Layout>
