---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { ARTICLES, type Article } from '../../data/articles';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

export interface Props {
  article: Article;
}

const { article } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  image: article.coverImage,
  datePublished: article.publishDate,
  author: {
    '@type': 'Person',
    name: article.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'An Gia Tịnh',
    logo: {
      '@type': 'ImageObject',
      url: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=200&q=80',
    },
  },
};
---

<Layout
  title={`${article.title} — An Gia Tịnh`}
  description={article.description}
  image={article.coverImage}
  type="article"
  schema={articleSchema}
>
  {/* Article Header */}
  <header class="bg-gradient-to-b from-stone-100/90 to-stone-50 border-b border-stone-200 py-14 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-900 text-xs font-semibold">
        <span>{article.category}</span>
        <span class="text-stone-300">•</span>
        <span>{article.readingTime}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl  font-black text-stone-900 leading-tight">
        {article.title}
      </h1>

      <div class="text-xs sm:text-sm text-stone-500 flex items-center justify-center gap-4 pt-1">
        <span>Tác giả: <strong class="text-stone-800 font-semibold">{article.author}</strong></span>
        <span>•</span>
        <span>Cập nhật: 31/10/2026</span>
      </div>
    </div>
  </header>

  {/* Main Content */}
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="bg-white p-6 sm:p-12 rounded-3xl border border-stone-200 shadow-sm">
      {/* Cover Image */}
      <div class="aspect-16/9 rounded-2xl overflow-hidden mb-8 shadow-sm bg-stone-100 border border-stone-200">
        <img
          src={article.coverImage}
          alt={article.title}
          class="w-full h-full object-cover"
        />
      </div>

      {/* Hierarchical Nested TOC */}
      <TableOfContents headings={article.headings} />

      {/* Body Content */}
      <div class="prose prose-lg max-w-none text-stone-800 leading-relaxed space-y-6 text-sm sm:text-base">
        <Fragment set:html={article.contentHtml} />
      </div>

      {/* Author Credential Box */}
      <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col sm:flex-row items-center gap-5 shadow-xs">
        <div class="w-14 h-14 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-700 flex items-center justify-center shrink-0 shadow-xs">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C12 2 8 8 8 13C8 16.5 10.5 19 12 19C13.5 19 16 16.5 16 13C16 8 12 2 12 2ZM12 17C11.2 17 9.8 15.2 9.8 13C9.8 10.4 11.5 6.4 12 5.1C12.5 6.4 14.2 10.4 14.2 13C14.2 15.2 12.8 17 12 17Z"/>
          </svg>
        </div>
        <div>
          <h4 class=" font-black text-base text-stone-900">
            {article.author}
          </h4>
          <p class="text-xs text-stone-600 mt-1.5 leading-relaxed font-light">
            Hơn 25 năm kinh nghiệm chế tác đồ thờ gỗ truyền thống cao cấp và phân phối trên toàn quốc. Cố vấn phong thủy Thước Lỗ Ban 38.8cm cho hàng nghìn gia đình gia chủ chung cư và nhà phố.
          </p>
        </div>
      </div>

      {/* Bottom CTA */}
      <div class="mt-10 p-8 sm:p-10 bg-gradient-to-br from-[#802219] via-[#6d1b13] to-[#59140e] text-white rounded-3xl border border-[#a83226] text-center space-y-4 shadow-xl">
        <h3 class="text-xl sm:text-2xl  font-black text-amber-400">
          Gia Chủ Cần Tư Vấn Kích Thước Bàn Thờ Hợp Mệnh?
        </h3>
        <p class="text-xs sm:text-sm text-stone-300 max-w-xl mx-auto leading-relaxed font-light">
          Đội ngũ chuyên gia An Gia Tịnh sẽ hỗ trợ tính toán chuẩn Thước Lỗ Ban 38.8cm và tư vấn chi tiết mẫu bàn thờ hợp mệnh qua Zalo.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a
            href="https://zalo.me/0339533380"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs sm:text-sm rounded-xl shadow-lg transition-all"
          >
            Nhắn Zalo Nghệ Nhân: 0339.533.380
          </a>
          <a
            href="/thuoc-lo-ban"
            class="px-6 py-3.5 bg-[#54160e] hover:bg-[#6e1e14] text-amber-100 font-semibold text-xs sm:text-sm rounded-xl border border-[#8f281e] transition-all"
          >
            Tra Cứu Thước Lỗ Ban
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
