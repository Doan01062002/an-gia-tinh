---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { ARTICLES, type Article } from '../../data/articles';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

export interface Props {
  article: Article;
}

const { article } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  image: article.coverImage,
  datePublished: article.publishDate,
  author: {
    '@type': 'Person',
    name: article.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'An Gia Tịnh',
    logo: {
      '@type': 'ImageObject',
      url: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=200&q=80',
    },
  },
};
---

<Layout
  title={`${article.title} — An Gia Tịnh`}
  description={article.description}
  image={article.coverImage}
  type="article"
  schema={articleSchema}
>
  {/* Article Header */}
  <header class="bg-gradient-to-b from-[#1C100A] to-[#25150E] text-white py-14 sm:py-20 border-b-4 border-[#CFA439]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#2E1A11] text-[#E2BE5F] text-xs font-semibold border border-[#CFA439]/40">
        <span>{article.category}</span>
        <span>•</span>
        <span>{article.readingTime}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl lg:text-5xl font-serif-luxury font-black text-[#FBF5DF] leading-tight">
        {article.title}
      </h1>

      <div class="text-xs sm:text-sm text-[#D8C7B5] flex items-center justify-center gap-4 pt-2">
        <span>Tác giả: <strong class="text-white">{article.author}</strong></span>
        <span>•</span>
        <span>Cập nhật: 31/10/2026</span>
      </div>
    </div>
  </header>

  {/* Main Content */}
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="bg-white p-6 sm:p-12 rounded-3xl border border-[#E6DED3] shadow-sm">
      {/* Cover Image */}
      <div class="aspect-16/9 rounded-3xl overflow-hidden mb-8 shadow-lg bg-[#F4E8DC]">
        <img
          src={article.coverImage}
          alt={article.title}
          class="w-full h-full object-cover"
        />
      </div>

      {/* Hierarchical Nested TOC */}
      <TableOfContents headings={article.headings} />

      {/* Body Content */}
      <div class="prose prose-lg max-w-none text-[#24140D] leading-relaxed space-y-6 text-sm sm:text-base">
        <Fragment set:html={article.contentHtml} />
      </div>

      {/* Author Credential Box */}
      <div class="mt-14 p-6 sm:p-8 rounded-3xl bg-[#FAF7F2] border border-[#D8A268]/60 flex flex-col sm:flex-row items-center gap-5 shadow-xs">
        <div class="w-16 h-16 rounded-2xl bg-[#1C100A] text-[#CFA439] flex items-center justify-center font-serif font-black text-2xl shrink-0 border border-[#CFA439]/50 shadow-md">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C12 2 8 8 8 13C8 16.5 10.5 19 12 19C13.5 19 16 16.5 16 13C16 8 12 2 12 2ZM12 17C11.2 17 9.8 15.2 9.8 13C9.8 10.4 11.5 6.4 12 5.1C12.5 6.4 14.2 10.4 14.2 13C14.2 15.2 12.8 17 12 17Z"/>
          </svg>
        </div>
        <div>
          <h4 class="font-serif-luxury font-bold text-base text-[#190F0A]">
            {article.author}
          </h4>
          <p class="text-xs text-[#543120] mt-1.5 leading-relaxed">
            Hơn 25 năm kinh nghiệm chế tác đồ thờ gỗ truyền thống tại làng nghề Canh Nậu - Thạch Thất và làng nghề đồ thờ Sơn Đồng - Hoài Đức, Hà Nội. Cố vấn phong thủy Thước Lỗ Ban 38.8cm cho hàng nghìn gia đình Việt.
          </p>
        </div>
      </div>

      {/* Bottom CTA */}
      <div class="mt-10 p-8 sm:p-10 bg-gradient-to-r from-[#1C100A] to-[#25150E] text-white rounded-3xl border-2 border-[#CFA439]/50 text-center space-y-4 shadow-xl">
        <h3 class="text-xl sm:text-2xl font-serif-luxury font-bold text-[#E2BE5F]">
          Gia Chủ Cần Tư Vấn Kích Thước Bàn Thờ Hợp Mệnh?
        </h3>
        <p class="text-xs sm:text-sm text-[#D8C7B5] max-w-xl mx-auto leading-relaxed">
          Nghệ nhân xưởng An Gia Tịnh sẽ tính toán chuẩn Thước Lỗ Ban 38.8cm và quay video mộc thô 15s gửi trực tiếp qua Zalo.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a
            href="https://zalo.me/0339533380"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 bg-gradient-to-r from-[#CFA439] to-[#AF8729] hover:from-[#E2BE5F] hover:to-[#CFA439] text-[#190F0A] font-bold text-xs sm:text-sm rounded-xl shadow-lg transition-all"
          >
            Nhắn Zalo Nghệ Nhân: 0339.533.380
          </a>
          <a
            href="/thuoc-lo-ban"
            class="px-6 py-3.5 bg-[#2E1A11] hover:bg-[#3D2517] text-[#FBF5DF] font-semibold text-xs sm:text-sm rounded-xl border border-[#CFA439]/40 transition-all"
          >
            Tra Cứu Thước Lỗ Ban
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
