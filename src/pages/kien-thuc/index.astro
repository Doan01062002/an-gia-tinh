---
import Layout from '../../layouts/Layout.astro';
import { ARTICLES } from '../../data/articles';
import { PRODUCTS } from '../../data/products';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Cẩm Nang Văn Khấn & Phong Thủy Bàn Thờ — An Gia Tịnh',
  description: 'Chuyên mục chia sẻ kiến thức chuẩn phong thủy về Thước Lỗ Ban 38.8cm, bài văn khấn an vị bàn thờ gia tiên, cách nhận biết gỗ lõi không dính rác.',
  url: 'https://an-gia-tinh.vercel.app/kien-thuc',
};

const featuredArticle = ARTICLES[0];
const remainingArticles = ARTICLES.slice(1);
const featuredProducts = PRODUCTS.slice(0, 3);

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}
---

<Layout
  title="Cẩm Nang Không Gian Thờ Tự & Văn Khấn Cổ Truyền — An Gia Tịnh"
  description="Chia sẻ kinh nghiệm chọn bàn thờ chung cư chuẩn Lỗ Ban 38.8cm, bài văn khấn an vị bàn thờ mới, cách phân biệt 100% gỗ lõi tự nhiên không dính rác."
  schema={blogSchema}
>
  {/* 1. Compact Header & Breadcrumbs */}
  <section class="bg-gradient-to-b from-stone-100/90 via-stone-50 to-[#FAF9F6] border-b border-stone-200/80 pt-2.5 pb-3.5 sm:pt-3.5 sm:pb-4.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb Navigation */}
      <nav class="flex items-center gap-2 text-[11px] text-stone-500 mb-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-800 transition-colors">Trang Chủ</a>
        <span>/</span>
        <span class="text-stone-800 font-semibold">Cẩm Nang Thờ Cúng</span>
      </nav>

      <div class="max-w-3xl space-y-1.5">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-900 text-[11px] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
          <span>Kiến Thức Làng Nghề & Tâm Linh Cổ Truyền</span>
        </div>

        <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-stone-900 tracking-tight leading-snug">
          Cẩm Nang Không Gian Thờ Tự
        </h1>

        <p class="text-stone-600 text-xs sm:text-sm leading-normal font-light">
          Tổng hợp kiến thức phong thủy Thước Lỗ Ban 38.8cm, bài văn khấn gia tiên truyền thống và bí quyết thẩm định gỗ lõi tự nhiên từ nghệ nhân mộc.
        </p>

        {/* Quick Category Badges */}
        <div class="flex flex-wrap gap-1.5 pt-1">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-800 text-white shadow-2xs">
            Tất Cả ({ARTICLES.length})
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-white text-stone-700 border border-stone-200">
            Phong Thủy Bàn Thờ (1)
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-white text-stone-700 border border-stone-200">
            Kiến Thức Nghề Mộc (1)
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-white text-stone-700 border border-stone-200">
            Văn Khấn Cổ Truyền (1)
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Main Editorial Content Area */}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 sm:py-6">
    {/* 2.1 Magazine Featured Story (Pillar Hero Card) */}
    {featuredArticle && (
      <div class="mb-12 sm:mb-16">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-black uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-600"></span>
            Chuyên Đề Nổi Bật
          </span>
          <span class="text-xs text-stone-500 font-medium hidden sm:inline">
            Cập nhật liên tục theo phong thủy cổ truyền
          </span>
        </div>

        <div class="bg-white rounded-3xl overflow-hidden border border-stone-200/90 shadow-md hover:shadow-xl transition-all duration-300 grid grid-cols-1 lg:grid-cols-12 group">
          {/* Featured Image */}
          <div class="lg:col-span-7 aspect-16/9 lg:aspect-auto overflow-hidden bg-stone-100 relative">
            <img
              src={featuredArticle.coverImage}
              alt={featuredArticle.title}
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-700"
              loading="eager"
              decoding="async"
              width="700"
              height="394"
            />
            <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-[#451a03]/90 text-amber-200 text-xs font-bold shadow-xs">
              {featuredArticle.category}
            </span>
          </div>

          {/* Featured Text Content */}
          <div class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center gap-2.5 text-xs text-stone-500">
                <span class="font-semibold text-amber-800">{featuredArticle.readingTime}</span>
                <span>•</span>
                <span>Xuất bản: {featuredArticle.publishDate}</span>
              </div>

              <h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-stone-900 group-hover:text-amber-800 transition-colors leading-snug">
                <a href={`/kien-thuc/${featuredArticle.slug}`}>
                  {featuredArticle.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed font-light">
                {featuredArticle.description}
              </p>

              {/* Highlights from article */}
              <div class="pt-2 space-y-1.5 text-xs text-stone-700 border-t border-stone-100">
                <div class="flex items-center gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>Phân biệt chuẩn xác Thước 38.8cm (Âm phần) vs 42.9cm vs 52.2cm</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>Giải mã 3 kích thước vàng: 48x81cm, 48x89cm và 61x107cm</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>Tầm cao lắp đặt cung Phú Quý & Tiến Bảo tránh xà ngang</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-900 font-bold text-xs flex items-center justify-center shrink-0">
                  BT
                </div>
                <div>
                  <span class="block text-xs font-bold text-stone-800">
                    {featuredArticle.author.split('(')[0].trim()}
                  </span>
                  <span class="block text-[10px] text-stone-500">Thợ Cả An Gia Tịnh</span>
                </div>
              </div>

              <a
                href={`/kien-thuc/${featuredArticle.slug}`}
                class="px-4 py-2 bg-gradient-to-r from-red-700 to-amber-900 hover:from-red-800 hover:to-amber-950 text-white text-xs font-bold rounded-xl shadow-xs transition-all flex items-center gap-1 group/btn"
              >
                <span>Đọc chi tiết</span>
                <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    {/* 2.2 Articles Grid & Sidebar Layout */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
      {/* Articles Column (Col 8) */}
      <div class="lg:col-span-8 space-y-6">
        <div class="flex items-center justify-between pb-2 border-b border-stone-200">
          <h2 class="text-lg sm:text-xl font-black text-stone-900">
            Tất Cả Bài Viết Hướng Dẫn
          </h2>
          <span class="text-xs text-stone-500 font-medium">
            {ARTICLES.length} bài viết
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {ARTICLES.map((article) => (
            <article class="bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-2xs hover:shadow-xl hover:border-amber-700/30 transition-all duration-300 flex flex-col group">
              <div class="aspect-16/9 overflow-hidden bg-stone-100 relative">
                <img
                  src={article.coverImage}
                  alt={article.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="500"
                  height="281"
                />
                <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-[#451a03]/90 text-amber-200 text-[10px] font-bold shadow-xs">
                  {article.category}
                </span>
              </div>

              <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-3">
                <div>
                  <div class="flex items-center gap-2 text-[11px] text-stone-500 mb-2">
                    <span class="font-semibold text-amber-800">{article.readingTime}</span>
                    <span>•</span>
                    <span>{article.publishDate}</span>
                  </div>

                  <h3 class="text-base font-bold text-stone-900 group-hover:text-amber-800 transition-colors line-clamp-2 leading-snug mb-2">
                    <a href={`/kien-thuc/${article.slug}`}>
                      {article.title}
                    </a>
                  </h3>

                  <p class="text-xs text-stone-600 line-clamp-2 font-light leading-relaxed">
                    {article.description}
                  </p>
                </div>

                <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-xs">
                  <span class="text-stone-500 text-[11px] font-medium truncate max-w-[140px]">
                    {article.author.split('(')[0].trim()}
                  </span>
                  <a
                    href={`/kien-thuc/${article.slug}`}
                    class="font-bold text-amber-800 hover:text-amber-900 flex items-center gap-1 group/btn"
                  >
                    <span>Đọc tiếp</span>
                    <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {/* Free PDF Document CTA Card */}
        <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#802219] via-[#6d1b13] to-[#59140e] text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl border border-amber-900/40">
          <div class="space-y-2 text-center sm:text-left">
            <span class="text-[10px] font-bold uppercase tracking-widest text-amber-300 block">
              Quà Tặng Tâm Linh Miễn Phí
            </span>
            <h3 class="text-lg sm:text-2xl font-black text-white">
              Tải Trọn Bộ Văn Khấn An Vị & Tra Hướng Lỗ Ban
            </h3>
            <p class="text-xs sm:text-sm text-amber-100/80 font-light max-w-md">
              Xưởng An Gia Tịnh gửi tặng gia chủ tài liệu PDF chuẩn nghi lễ cổ truyền và tư vấn hướng đặt bàn thờ theo tuổi qua Zalo.
            </p>
          </div>

          <a
            href="https://zalo.me/0339533380?text=Ch%C3%A0o%20x%C6%B0%E1%BB%9Fng%20An%20Gia%20T%E1%BB%8Bnh,%20g%E1%BB%ADi%20gi%C3%BAp%20t%C3%B4i%20file%20PDF%20tr%E1%BB%8Dn%20b%E1%BB%99%20v%C4%83n%20kh%E1%BA%A5n%20an%20v%E1%BB%8B%20b%C3%A0n%20th%E1%BB%9D%20nh%C3%A9!"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-amber-400 hover:bg-amber-300 text-stone-950 text-xs sm:text-sm font-bold rounded-xl shadow-md transition-all shrink-0 active:scale-95 text-center"
          >
            Nhận File PDF Qua Zalo
          </a>
        </div>
      </div>

      {/* Sidebar Column (Col 4) */}
      <div class="lg:col-span-4 space-y-6">
        {/* Sidebar 1: Quick Feng Shui Tool */}
        <div class="p-5 sm:p-6 rounded-2xl bg-white border border-stone-200 shadow-2xs space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-amber-500/15 text-amber-800 flex items-center justify-center font-bold text-sm">
              🧭
            </div>
            <div>
              <h3 class="font-bold text-sm text-stone-900">Tiện Ích Phong Thủy</h3>
              <p class="text-[11px] text-stone-500">Tra cứu nhanh chính xác</p>
            </div>
          </div>

          <p class="text-xs text-stone-600 leading-relaxed font-light">
            Sử dụng công cụ trực tuyến để kiểm tra cung đỏ Thước Lỗ Ban 38.8cm và 4 hướng Đại Cát theo năm sinh của gia chủ.
          </p>

          <div class="space-y-2">
            <a
              href="/thuoc-lo-ban"
              class="block w-full py-2.5 px-3.5 bg-stone-50 hover:bg-stone-100 rounded-xl text-xs font-bold text-stone-800 border border-stone-200 transition-colors text-center"
            >
              Tra Cứu Thước Lỗ Ban 38.8cm Online →
            </a>
            <a
              href="/#bo-suu-tap"
              class="block w-full py-2.5 px-3.5 bg-amber-50 hover:bg-amber-100 rounded-xl text-xs font-bold text-amber-900 border border-amber-200 transition-colors text-center"
            >
              Xem Bộ Sưu Tập Bàn Thờ Chuẩn Mộc →
            </a>
          </div>
        </div>

        {/* Sidebar 2: Recommended Best-Selling Altars */}
        <div class="p-5 sm:p-6 rounded-2xl bg-white border border-stone-200 shadow-2xs space-y-4">
          <h3 class="font-bold text-sm text-stone-900 pb-2 border-b border-stone-100 flex items-center justify-between">
            <span>Mẫu Bàn Thờ Khuyên Dùng</span>
            <span class="text-[10px] text-amber-800 bg-amber-50 px-2 py-0.5 rounded font-bold">100% Gỗ Lõi</span>
          </h3>

          <div class="space-y-3">
            {featuredProducts.map((p) => (
              <a
                href={`/san-pham/${p.slug}`}
                class="flex items-center gap-3 p-2 rounded-xl hover:bg-stone-50 transition-colors group"
              >
                <div class="w-16 h-16 rounded-lg overflow-hidden bg-stone-100 shrink-0 border border-stone-200">
                  <img
                    src={p.imageUrl}
                    alt={p.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    loading="lazy"
                    decoding="async"
                    width="64"
                    height="64"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <span class="block text-[11px] font-bold text-stone-900 truncate group-hover:text-amber-800 transition-colors">
                    {p.name}
                  </span>
                  <span class="block text-[10px] text-stone-500 truncate mt-0.5">
                    {p.dimensions} • {p.woodType.split(' ')[1] || 'Gỗ tự nhiên'}
                  </span>
                  <span class="block text-xs font-black text-red-700 mt-1">
                    {formatCurrency(p.price)}
                  </span>
                </div>
              </a>
            ))}
          </div>

          <a
            href="/san-pham"
            class="block text-center text-xs font-bold text-amber-800 hover:text-amber-900 pt-2"
          >
            Xem tất cả {PRODUCTS.length} mẫu bàn thờ →
          </a>
        </div>

        {/* Sidebar 3: Artisan Hot Contact */}
        <div class="p-5 sm:p-6 rounded-2xl bg-stone-100/80 border border-stone-200 space-y-3 text-center">
          <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500 block">
            Hỗ Trợ Trực Tiếp 24/7
          </span>
          <h4 class="font-black text-base text-stone-900">
            Nghệ Nhân Bùi Văn Thắng
          </h4>
          <p class="text-xs text-stone-600 font-light leading-relaxed">
            Tư vấn chi tiết về kích thước Lỗ Ban theo diện tích phòng và quy trình kiểm định thớ gỗ mộc 15s.
          </p>
          <a
            href="tel:0339533380"
            class="inline-flex items-center justify-center gap-2 w-full py-3 bg-[#451a03] hover:bg-[#5c2406] text-white text-xs font-bold rounded-xl shadow-xs transition-colors"
          >
            <span>Gọi Hotline: 0339.533.380</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
