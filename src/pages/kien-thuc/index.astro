---
import Layout from '../../layouts/Layout.astro';
import { ARTICLES } from '../../data/articles';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Cẩm Nang Văn Khấn & Phong Thủy Bàn Thờ — An Gia Tịnh',
  description: 'Chuyên mục chia sẻ kiến thức chuẩn phong thủy về Thước Lỗ Ban 38.8cm, bài văn khấn an vị bàn thờ gia tiên, cách nhận biết gỗ lõi không dính rác.',
  url: 'https://an-gia-tinh.vercel.app/kien-thuc',
};
---

<Layout
  title="Cẩm Nang Văn Khấn & Phong Thủy Bàn Thờ — An Gia Tịnh"
  description="Chia sẻ kinh nghiệm chọn bàn thờ chung cư chuẩn Lỗ Ban 38.8cm, bài văn khấn an vị bàn thờ mới, cách phân biệt 100% gỗ lõi tự nhiên không dính rác."
  schema={blogSchema}
>
  {/* Category Header */}
  <section class="bg-gradient-to-b from-stone-100/90 to-stone-50 border-b border-stone-200 py-14 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-900 text-xs font-semibold tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
        <span>Kiến Thức Mộc Làng Nghề & Tâm Linh Cổ Truyền</span>
      </div>

      <h1 class="text-3xl sm:text-5xl  font-black text-stone-900 tracking-tight">
        Cẩm Nang Không Gian Thờ Tự
      </h1>

      <p class="text-stone-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Tổng hợp các bài viết hướng dẫn chuyên sâu về phong thủy Thước Lỗ Ban 38.8cm, trọn bộ bài văn khấn gia tiên và cẩm nang kiểm tra gỗ lõi không rác.
      </p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {ARTICLES.map((article) => (
        <article class="bg-white rounded-2xl overflow-hidden border border-stone-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col group">
          <div class="aspect-16/9 overflow-hidden bg-stone-100">
            <img
              src={article.coverImage}
              alt={article.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs mb-3">
                <span class="px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 font-semibold border border-amber-200/60">
                  {article.category}
                </span>
                <span class="text-stone-300">•</span>
                <span class="text-stone-500 font-medium">{article.readingTime}</span>
              </div>

              <h2 class="text-lg sm:text-xl  font-black text-stone-900 group-hover:text-amber-700 transition-colors line-clamp-2 mb-3 leading-snug">
                <a href={`/kien-thuc/${article.slug}`}>
                  {article.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-stone-600 line-clamp-3 mb-6 leading-relaxed">
                {article.description}
              </p>
            </div>

            <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
              <span class="font-medium truncate max-w-[180px]">{article.author}</span>
              <a
                href={`/kien-thuc/${article.slug}`}
                class="font-bold text-amber-700 hover:text-amber-800 flex items-center gap-1 group/btn"
              >
                <span>Đọc bài viết</span>
                <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
