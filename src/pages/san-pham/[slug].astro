---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import type { Product } from '../../types';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}

const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id).slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.imageUrl,
  description: product.description,
  sku: product.id,
  brand: {
    '@type': 'Brand',
    name: 'An Gia Tịnh',
  },
  offers: {
    '@type': 'Offer',
    url: `https://an-gia-tinh.vercel.app/san-pham/${product.slug}`,
    priceCurrency: 'VND',
    price: product.price,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
  },
};
---

<Layout
  title={`${product.name} — Chuẩn Lỗ Ban 38.8cm | An Gia Tịnh`}
  description={`${product.name}. Kích thước ${product.dimensions}. 100% gỗ lõi tự nhiên không rác (Đền bù 200%). Gửi clip mộc 15s qua Zalo trước khi giao COD toàn quốc.`}
  image={product.imageUrl}
  type="product"
  schema={productSchema}
>
  {/* Breadcrumbs */}
  <div class="bg-wood-100/70 border-b border-wood-200/80 py-3 text-xs text-wood-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-gold-600">Trang Chủ</a>
      <span>/</span>
      <a href="/san-pham" class="hover:text-gold-600">Sản Phẩm</a>
      <span>/</span>
      <span class="text-wood-950 font-semibold truncate">{product.name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      {/* Left Column: Image showcase */}
      <div class="lg:col-span-6 space-y-4">
        <div class="aspect-4/3 rounded-3xl overflow-hidden shadow-2xl border-2 border-wood-200/80 bg-wood-100">
          <img
            src={product.imageUrl}
            alt={product.name}
            class="w-full h-full object-cover"
          />
        </div>

        {/* Trust verification banner */}
        <div class="p-4 rounded-2xl bg-wood-50 border border-wood-200 text-xs text-wood-700 flex items-center justify-between">
          <div class="flex items-center gap-2 font-bold text-red-700">
            <span>🛡️</span>
            <span>Cam Kết Gỗ Lõi Đền 200%</span>
          </div>
          <div class="text-wood-500">Bảo hành {product.warrantyYears} năm</div>
        </div>
      </div>

      {/* Right Column: Specs & Buying CTAs */}
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-bold text-gold-600 uppercase tracking-widest block mb-2">
            {product.categoryName}
          </span>
          <h1 class="text-2xl sm:text-4xl font-serif font-black text-wood-950 leading-snug">
            {product.name}
          </h1>

          <div class="flex items-center gap-3 mt-3 text-xs sm:text-sm">
            <div class="flex items-center text-amber-500 font-bold">
              <span>★★★★★</span>
              <span class="text-wood-800 ml-1.5">{product.rating}</span>
            </div>
            <span class="text-wood-300">•</span>
            <span class="text-wood-600">{product.reviewCount} gia chủ đã thỉnh</span>
            <span class="text-wood-300">•</span>
            <span class="text-green-700 font-bold">Sẵn mộc thô tại xưởng</span>
          </div>
        </div>

        {/* Pricing Box */}
        <div class="p-5 rounded-2xl bg-wood-50 border border-wood-200/80 flex items-baseline justify-between">
          <div>
            <span class="text-xs text-wood-500 block">Giá xưởng ưu đãi:</span>
            <div class="flex items-baseline gap-3">
              <span class="text-3xl font-serif font-black text-red-700">
                {formatCurrency(product.price)}
              </span>
              <span class="text-sm text-wood-400 line-through">
                {formatCurrency(product.originalPrice)}
              </span>
            </div>
          </div>
          <span class="text-xs font-bold text-red-700 bg-red-100 px-3 py-1 rounded-full">
            Tiết kiệm {formatCurrency(product.originalPrice - product.price)}
          </span>
        </div>

        {/* Feng-shui Lỗ Ban Card */}
        <div class="p-6 rounded-2xl bg-red-50/80 border-2 border-red-300 text-xs sm:text-sm text-red-900 space-y-3 shadow-sm">
          <div class="flex items-center gap-2 text-sm font-bold text-red-800">
            <span>📐</span>
            <span>Ý Nghĩa Kích Thước Thước Lỗ Ban 38.8cm:</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-white/80 rounded-xl border border-red-200">
              <span class="font-bold text-red-700 block">Kích thước chiều sâu:</span>
              <span class="text-wood-900 font-semibold">{product.lobanInfo.depthCung}</span>
              <p class="text-wood-600 text-[11px] mt-0.5">{product.lobanInfo.depthMeaning}</p>
            </div>
            <div class="p-3 bg-white/80 rounded-xl border border-red-200">
              <span class="font-bold text-red-700 block">Kích thước chiều rộng:</span>
              <span class="text-wood-900 font-semibold">{product.lobanInfo.widthCung}</span>
              <p class="text-wood-600 text-[11px] mt-0.5">{product.lobanInfo.widthMeaning}</p>
            </div>
          </div>
        </div>

        {/* Highlights */}
        <div>
          <h3 class="text-xs font-bold text-wood-900 uppercase tracking-wider mb-3">
            Đặc điểm mộc truyền thống:
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-wood-800">
            {product.features.map((feature) => (
              <li class="flex items-start gap-2.5">
                <span class="text-red-700 font-bold">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* Action Buttons */}
        <div class="pt-4 space-y-3">
          <a
            href="https://zalo.me/0339533380"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 bg-gradient-to-r from-red-700 via-red-800 to-red-900 hover:from-red-800 hover:to-red-950 text-white font-bold text-base rounded-xl shadow-xl hover:shadow-red-700/30 transition-all flex items-center justify-center gap-2"
          >
            <span>🎥</span>
            <span>Nhận Clip Mộc Thô 15s Qua Zalo</span>
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a
              href="tel:0339533380"
              class="py-3 px-4 bg-wood-900 hover:bg-wood-800 text-white text-xs sm:text-sm font-semibold rounded-xl text-center flex items-center justify-center gap-2 transition-colors"
            >
              <span>📞</span>
              <span>Gọi Thợ Cả Xưởng</span>
            </a>
            <a
              href="/thuoc-lo-ban"
              class="py-3 px-4 bg-wood-100 hover:bg-wood-200 text-wood-900 text-xs sm:text-sm font-semibold rounded-xl text-center flex items-center justify-center gap-2 transition-colors border border-wood-200"
            >
              <span>📐</span>
              <span>Tra Thước Lỗ Ban</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Related products */}
    <div class="mt-20 pt-12 border-t border-wood-200">
      <h2 class="text-xl sm:text-3xl font-serif font-bold text-wood-950 mb-8">
        Mẫu Bàn Thờ Cùng Phân Khúc Có Thể Gia Chủ Quan Tâm
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {relatedProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </div>
</Layout>
