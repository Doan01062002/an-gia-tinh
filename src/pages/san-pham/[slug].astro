---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import type { Product } from '../../types';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}

const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id).slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.imageUrl,
  description: product.description,
  sku: product.id,
  brand: {
    '@type': 'Brand',
    name: 'An Gia Tịnh',
  },
  offers: {
    '@type': 'Offer',
    url: `https://an-gia-tinh.vercel.app/san-pham/${product.slug}`,
    priceCurrency: 'VND',
    price: product.price,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
  },
};
---

<Layout
  title={`${product.name} — Chuẩn Lỗ Ban 38.8cm | An Gia Tịnh`}
  description={`${product.name}. Kích thước ${product.dimensions}. 100% gỗ lõi tự nhiên không rác (Đền bù 200%). Gửi clip mộc 15s qua Zalo trước khi giao COD toàn quốc.`}
  image={product.imageUrl}
  type="product"
  schema={productSchema}
>
  {/* Breadcrumb Bar */}
  <div class="bg-[#F4E8DC] border-b border-[#D8C7B5] py-3 text-xs text-[#73432C]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-[#8F1717]">Trang Chủ</a>
      <span>/</span>
      <a href="/san-pham" class="hover:text-[#8F1717]">Sản Phẩm</a>
      <span>/</span>
      <span class="text-[#190F0A] font-semibold truncate">{product.name}</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      {/* Left Column: Product Showcase */}
      <div class="lg:col-span-6 space-y-4">
        <div class="aspect-4/3 rounded-3xl overflow-hidden shadow-2xl border-2 border-[#D8A268]/60 bg-[#F4E8DC]">
          <img
            src={product.imageUrl}
            alt={product.name}
            class="w-full h-full object-cover"
          />
        </div>

        {/* Guarantee Banner */}
        <div class="p-4 rounded-2xl bg-[#FAF7F2] border border-[#E6DED3] text-xs text-[#543120] flex items-center justify-between">
          <div class="flex items-center gap-2 font-bold text-[#8F1717]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>Cam Kết 100% Gỗ Lõi (Đền Bù 200%)</span>
          </div>
          <div class="text-[#73432C]">Bảo hành {product.warrantyYears} năm</div>
        </div>
      </div>

      {/* Right Column: Specs & CTAs */}
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-bold text-[#AF8729] uppercase tracking-widest block mb-2">
            {product.categoryName}
          </span>
          <h1 class="text-2xl sm:text-4xl font-serif-luxury font-black text-[#190F0A] leading-snug">
            {product.name}
          </h1>

          <div class="flex items-center gap-3 mt-3 text-xs sm:text-sm">
            <div class="flex items-center text-[#AF8729] font-bold">
              <span>★★★★★</span>
              <span class="text-[#190F0A] ml-1.5">{product.rating}</span>
            </div>
            <span class="text-[#D8C7B5]">•</span>
            <span class="text-[#543120]">{product.reviewCount} gia chủ đã thỉnh</span>
            <span class="text-[#D8C7B5]">•</span>
            <span class="text-emerald-800 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-xs">
              Sẵn mộc tại xưởng
            </span>
          </div>
        </div>

        {/* Price Card */}
        <div class="p-5 rounded-2xl bg-[#FAF7F2] border border-[#E6DED3] flex items-baseline justify-between">
          <div>
            <span class="text-xs text-[#73432C] block">Giá xưởng ưu đãi:</span>
            <div class="flex items-baseline gap-3">
              <span class="text-3xl font-serif-classic font-black text-[#8F1717]">
                {formatCurrency(product.price)}
              </span>
              <span class="text-sm text-[#A88B74] line-through">
                {formatCurrency(product.originalPrice)}
              </span>
            </div>
          </div>
          <span class="text-xs font-bold text-[#8F1717] bg-[#FEF2F2] border border-[#8F1717]/20 px-3 py-1 rounded-full">
            Tiết kiệm {formatCurrency(product.originalPrice - product.price)}
          </span>
        </div>

        {/* Lỗ Ban Box */}
        <div class="p-6 rounded-2xl bg-[#FEF2F2] border-2 border-[#8F1717]/30 text-xs sm:text-sm text-[#8F1717] space-y-3">
          <div class="flex items-center justify-between text-sm font-bold">
            <span>Ý Nghĩa Kích Thước Thước Lỗ Ban 38.8cm:</span>
            <span class="bg-[#8F1717] text-white text-[10px] font-sans px-2.5 py-0.5 rounded-full uppercase">
              Cung Đỏ Cát Tường
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-white rounded-xl border border-[#8F1717]/20">
              <span class="font-bold text-[#8F1717] block">Chiều sâu:</span>
              <span class="text-[#190F0A] font-semibold">{product.lobanInfo.depthCung}</span>
              <p class="text-[#73432C] text-[11px] mt-0.5">{product.lobanInfo.depthMeaning}</p>
            </div>
            <div class="p-3 bg-white rounded-xl border border-[#8F1717]/20">
              <span class="font-bold text-[#8F1717] block">Chiều rộng:</span>
              <span class="text-[#190F0A] font-semibold">{product.lobanInfo.widthCung}</span>
              <p class="text-[#73432C] text-[11px] mt-0.5">{product.lobanInfo.widthMeaning}</p>
            </div>
          </div>
        </div>

        {/* Features */}
        <div>
          <h3 class="text-xs font-bold text-[#190F0A] uppercase tracking-wider mb-3">
            Đặc điểm mộc truyền thống:
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-[#301B12]">
            {product.features.map((feature) => (
              <li class="flex items-start gap-2.5">
                <span class="text-[#8F1717] font-bold">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* CTAs */}
        <div class="pt-4 space-y-3">
          <a
            href="https://zalo.me/0339533380"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 bg-gradient-to-r from-[#8F1717] via-[#AA1919] to-[#8F1717] hover:from-[#AA1919] hover:to-[#7A1313] text-[#FBF5DF] font-bold text-sm sm:text-base rounded-xl shadow-xl hover:shadow-[#8F1717]/30 transition-all flex items-center justify-center gap-2"
          >
            <span>Nhận Video Mộc Thô 15s Qua Zalo</span>
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a
              href="tel:0339533380"
              class="py-3 px-4 bg-[#1C100A] hover:bg-[#2C190F] text-[#FBF5DF] text-xs sm:text-sm font-semibold rounded-xl text-center transition-colors"
            >
              Gọi Nghệ Nhân Xưởng
            </a>
            <a
              href="/thuoc-lo-ban"
              class="py-3 px-4 bg-[#F4E8DC] hover:bg-[#E8D0BD] text-[#190F0A] text-xs sm:text-sm font-semibold rounded-xl text-center transition-colors border border-[#D8C7B5]"
            >
              Tra Thước Lỗ Ban
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Related Products */}
    <div class="mt-20 pt-12 border-t border-[#E6DED3]">
      <h2 class="text-xl sm:text-3xl font-serif-luxury font-bold text-[#190F0A] mb-8">
        Mẫu Bàn Thờ Cùng Phân Khúc
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {relatedProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </div>
</Layout>
