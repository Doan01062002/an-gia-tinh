---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import type { Product } from '../../types';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}

const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id).slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.imageUrl,
  description: product.description,
  sku: product.id,
  brand: {
    '@type': 'Brand',
    name: 'An Gia Tịnh',
  },
  offers: {
    '@type': 'Offer',
    url: `https://an-gia-tinh.vercel.app/san-pham/${product.slug}`,
    priceCurrency: 'VND',
    price: product.price,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
  },
};
---

<Layout
  title={`${product.name} — Chuẩn Lỗ Ban 38.8cm | An Gia Tịnh`}
  description={`${product.name}. Kích thước ${product.dimensions}. 100% gỗ lõi tự nhiên không rác (Đền bù 200%). Gửi clip mộc 15s qua Zalo trước khi giao COD toàn quốc.`}
  image={product.imageUrl}
  type="product"
  schema={productSchema}
>
  {/* Breadcrumb Bar */}
  <nav class="bg-stone-100/80 border-b border-stone-200 py-3 text-xs text-stone-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-amber-700 transition-colors">Trang Chủ</a>
      <span class="text-stone-300">/</span>
      <a href="/san-pham" class="hover:text-amber-700 transition-colors">Sản Phẩm</a>
      <span class="text-stone-300">/</span>
      <span class="text-stone-900 font-semibold truncate">{product.name}</span>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      {/* Left Column: Product Showcase */}
      <div class="lg:col-span-6 space-y-4">
        <div class="aspect-4/3 rounded-2xl overflow-hidden shadow-sm border border-stone-200 bg-stone-100">
          <img
            src={product.imageUrl}
            alt={product.name}
            class="w-full h-full object-cover"
          />
        </div>

        {/* Guarantee Banner */}
        <div class="p-4 rounded-xl bg-white border border-stone-200 text-xs text-stone-700 flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2 font-bold text-emerald-800">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>Cam Kết 100% Gỗ Lõi (Đền Bù 200%)</span>
          </div>
          <div class="text-stone-500 font-medium">Bảo hành {product.warrantyYears} năm</div>
        </div>
      </div>

      {/* Right Column: Specs & CTAs */}
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-bold text-amber-700 uppercase tracking-widest block mb-2">
            {product.categoryName}
          </span>
          <h1 class="text-2xl sm:text-4xl  font-black text-stone-900 leading-snug">
            {product.name}
          </h1>

          <div class="flex items-center gap-3 mt-3 text-xs sm:text-sm">
            <div class="flex items-center text-amber-500 font-bold">
              <span>★★★★★</span>
              <span class="text-stone-900 ml-1.5">{product.rating}</span>
            </div>
            <span class="text-stone-300">•</span>
            <span class="text-stone-600">{product.reviewCount} gia chủ đã thỉnh</span>
            <span class="text-stone-300">•</span>
            <span class="text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-xs">
              Sẵn mộc tại xưởng
            </span>
          </div>
        </div>

        {/* Price Card */}
        <div class="p-5 rounded-2xl bg-stone-50 border border-stone-200 flex items-baseline justify-between">
          <div>
            <span class="text-xs text-stone-500 block font-medium">Giá xưởng ưu đãi:</span>
            <div class="flex items-baseline gap-3 mt-1">
              <span class="text-3xl  font-black text-rose-700">
                {formatCurrency(product.price)}
              </span>
              <span class="text-sm text-stone-400 line-through">
                {formatCurrency(product.originalPrice)}
              </span>
            </div>
          </div>
          <span class="text-xs font-bold text-rose-700 bg-rose-50 border border-rose-200 px-3 py-1 rounded-full">
            Tiết kiệm {formatCurrency(product.originalPrice - product.price)}
          </span>
        </div>

        {/* Lỗ Ban Box */}
        <div class="p-5 sm:p-6 rounded-2xl bg-rose-50/70 border border-rose-200 text-xs sm:text-sm text-rose-950 space-y-3">
          <div class="flex items-center justify-between text-sm font-bold">
            <span>Ý Nghĩa Kích Thước Thước Lỗ Ban 38.8cm:</span>
            <span class="bg-rose-700 text-white text-[10px] font-sans px-2.5 py-0.5 rounded-full uppercase font-semibold">
              Cung Đỏ Cát Tường
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3.5 bg-white rounded-xl border border-rose-200 shadow-xs">
              <span class="font-bold text-rose-800 block">Chiều sâu:</span>
              <span class="text-stone-900 font-semibold">{product.lobanInfo.depthCung}</span>
              <p class="text-stone-600 text-[11px] mt-0.5">{product.lobanInfo.depthMeaning}</p>
            </div>
            <div class="p-3.5 bg-white rounded-xl border border-rose-200 shadow-xs">
              <span class="font-bold text-rose-800 block">Chiều rộng:</span>
              <span class="text-stone-900 font-semibold">{product.lobanInfo.widthCung}</span>
              <p class="text-stone-600 text-[11px] mt-0.5">{product.lobanInfo.widthMeaning}</p>
            </div>
          </div>
        </div>

        {/* Features */}
        <div>
          <h3 class="text-xs font-bold text-stone-900 uppercase tracking-wider mb-3">
            Đặc điểm mộc truyền thống:
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-stone-700">
            {product.features.map((feature) => (
              <li class="flex items-start gap-2.5">
                <span class="text-amber-600 font-bold">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* CTAs */}
        <div class="pt-4 space-y-3">
          <a
            href="https://zalo.me/0339533380"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 bg-rose-700 hover:bg-rose-800 text-white font-bold text-sm sm:text-base rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 group"
          >
            <span>Nhận Video Mộc Thô 15s Qua Zalo</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a
              href="tel:0339533380"
              class="py-3 px-4 bg-stone-900 hover:bg-stone-800 text-white text-xs sm:text-sm font-semibold rounded-xl text-center transition-colors shadow-xs"
            >
              Gọi Nghệ Nhân Xưởng
            </a>
            <a
              href="/thuoc-lo-ban"
              class="py-3 px-4 bg-white hover:bg-stone-50 text-stone-800 text-xs sm:text-sm font-semibold rounded-xl text-center transition-colors border border-stone-200 shadow-xs"
            >
              Tra Thước Lỗ Ban
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Related Products */}
    <div class="mt-20 pt-12 border-t border-stone-200">
      <h2 class="text-xl sm:text-3xl  font-black text-stone-900 mb-8">
        Mẫu Bàn Thờ Cùng Phân Khúc
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {relatedProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </div>
</Layout>
