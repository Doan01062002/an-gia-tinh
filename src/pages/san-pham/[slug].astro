---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductDetailGallery from '../../components/ProductDetailGallery';
import { PRODUCTS } from '../../data/products';
import type { Product } from '../../types';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

export interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCurrency(amount: number) {
  return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
}

const relatedProducts = PRODUCTS.filter((p) => p.id !== product.id).slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  image: product.imageUrl,
  description: product.description,
  sku: product.id,
  brand: {
    '@type': 'Brand',
    name: 'An Gia Tịnh',
  },
  offers: {
    '@type': 'Offer',
    url: `https://an-gia-tinh.vercel.app/san-pham/${product.slug}`,
    priceCurrency: 'VND',
    price: product.price,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: product.rating,
    reviewCount: product.reviewCount,
  },
};
---

<Layout
  title={`${product.name} — Chuẩn Lỗ Ban 38.8cm | An Gia Tịnh`}
  description={`${product.name}. Kích thước ${product.dimensions}. 100% gỗ lõi tự nhiên không rác (Đền bù 200%). Liên hệ tư vấn chuẩn phong thủy qua Zalo trước khi giao COD toàn quốc.`}
  image={product.imageUrl}
  type="product"
  schema={productSchema}
>
  {/* Breadcrumb Bar */}
  <nav class="bg-stone-100/80 border-b border-stone-200 py-3 text-xs text-stone-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-amber-700 transition-colors">Trang Chủ</a>
      <span class="text-stone-300">/</span>
      <a href="/san-pham" class="hover:text-amber-700 transition-colors">Sản Phẩm</a>
      <span class="text-stone-300">/</span>
      <span class="text-stone-900 font-semibold truncate">{product.name}</span>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      {/* Left Column: Product Showcase with Touch Swipe & Thumbnails */}
      <div class="lg:col-span-6 space-y-4">
        <ProductDetailGallery
          images={product.images && product.images.length > 0 ? product.images : [product.imageUrl]}
          name={product.name}
          client:load
        />

        {/* Guarantee Banner */}
        <div class="p-4 rounded-xl bg-white border border-stone-200 text-xs text-stone-700 flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2 font-bold text-amber-900">
            <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>100% Gỗ Tự Nhiên Tuyển Chọn</span>
          </div>
          <div class="text-stone-500 font-medium">Bảo hành {product.warrantyYears} năm</div>
        </div>
      </div>

      {/* Right Column: Specs & CTAs */}
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="text-xs font-bold text-amber-700 uppercase tracking-widest block mb-2">
            {product.categoryName}
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-stone-900 leading-snug">
            {product.name}
          </h1>

          <div class="flex items-center gap-3 mt-3 text-xs sm:text-sm">
            <div class="flex items-center text-amber-500 font-bold">
              <span>★★★★★</span>
              <span class="text-stone-900 ml-1.5">{product.rating}</span>
            </div>
            <span class="text-stone-300">•</span>
            <span class="text-stone-600">{product.reviewCount} gia chủ đã thỉnh</span>
            <span class="text-stone-300">•</span>
            <span class="text-emerald-700 font-semibold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 text-xs">
              Sẵn mộc tại xưởng
            </span>
          </div>
        </div>

        {/* Price Card */}
        <div class="p-4 sm:p-5 rounded-2xl bg-stone-50 border border-stone-200 flex items-baseline justify-between">
          <div>
            <span class="text-xs text-stone-500 block font-medium">Giá xưởng ưu đãi:</span>
            <div class="flex items-baseline gap-3 mt-1">
              <span class="text-2xl sm:text-3xl font-black text-[#c51c1c]">
                {formatCurrency(product.price)}
              </span>
              <span class="text-sm text-stone-400 line-through">
                {formatCurrency(product.originalPrice)}
              </span>
            </div>
          </div>
          <span class="text-xs font-bold text-[#c51c1c] bg-red-50 border border-red-200 px-3 py-1 rounded-full">
            Tiết kiệm {formatCurrency(product.originalPrice - product.price)}
          </span>
        </div>

        {/* Lỗ Ban Box */}
        <div class="p-4 sm:p-5 rounded-2xl bg-red-50/70 border border-red-200 text-xs sm:text-sm text-stone-900 space-y-3">
          <div class="flex items-center justify-between text-sm font-bold">
            <span class="text-red-900">Ý Nghĩa Kích Thước Thước Lỗ Ban 38.8cm:</span>
            <span class="bg-red-700 text-white text-[10px] px-2.5 py-0.5 rounded-full uppercase font-bold">
              Cung Đỏ Cát Tường
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 bg-white rounded-xl border border-red-200 shadow-2xs">
              <span class="font-bold text-red-800 block">Chiều sâu:</span>
              <span class="text-stone-900 font-bold">{product.lobanInfo.depthCung}</span>
              <p class="text-stone-600 text-[11px] mt-0.5">{product.lobanInfo.depthMeaning}</p>
            </div>
            <div class="p-3 bg-white rounded-xl border border-red-200 shadow-2xs">
              <span class="font-bold text-red-800 block">Chiều rộng:</span>
              <span class="text-stone-900 font-bold">{product.lobanInfo.widthCung}</span>
              <p class="text-stone-600 text-[11px] mt-0.5">{product.lobanInfo.widthMeaning}</p>
            </div>
          </div>
        </div>

        {/* Features */}
        <div>
          <h3 class="text-xs font-bold text-stone-900 uppercase tracking-wider mb-2.5">
            Đặc điểm mộc truyền thống:
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-stone-700">
            {product.features.map((feature) => (
              <li class="flex items-start gap-2.5">
                <span class="text-amber-600 font-bold">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        {/* CTAs: Single Prominent Lien He Button + Call Artisan */}
        <div class="pt-3 space-y-3">
          <a
            href={`https://zalo.me/0339533380?text=Ch%C3%A0o%20x%C6%B0%E1%BB%9Fng%20An%20Gia%20T%E1%BB%8Bnh,%20t%C3%B4i%20c%E1%BA%A7n%20t%C6%B0%20v%E1%BA%A5n%20v%C3%A0%20b%C3%A1o%20gi%C3%A1%20m%E1%BA%ABu%20${encodeURIComponent(product.name)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 bg-gradient-to-r from-red-700 via-red-800 to-amber-900 hover:from-red-800 hover:to-amber-950 text-white font-bold text-sm sm:text-base rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 group active:scale-98"
          >
            <svg class="w-5 h-5 text-amber-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            <span>Liên Hệ Tư Vấn & Báo Giá Xưởng</span>
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a
              href="tel:0339533380"
              class="py-3 px-4 bg-[#451a03] hover:bg-[#5c2406] text-white text-xs sm:text-sm font-semibold rounded-xl text-center transition-colors shadow-xs"
            >
              Gọi Nghệ Nhân Xưởng
            </a>
            <a
              href="/thuoc-lo-ban"
              class="py-3 px-4 bg-white hover:bg-stone-50 text-stone-800 text-xs sm:text-sm font-semibold rounded-xl text-center transition-colors border border-stone-200 shadow-xs"
            >
              Tra Thước Lỗ Ban
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Related Products */}
    <div class="mt-14 sm:mt-20 pt-10 border-t border-stone-200">
      <h2 class="text-xl sm:text-2xl font-black text-stone-900 mb-6">
        Mẫu Bàn Thờ Cùng Phân Khúc
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-6">
        {relatedProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </div>
</Layout>
