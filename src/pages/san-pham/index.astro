---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Danh Mục Bàn Thờ & Phụ Kiện Phòng Thờ An Gia Tịnh',
  itemListElement: PRODUCTS.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `https://an-gia-tinh.vercel.app/san-pham/${item.slug}`,
  })),
};
---

<Layout
  title="Bộ Sưu Tập Bàn Thờ Hiện Đại & Phụ Kiện Chuẩn Lỗ Ban — An Gia Tịnh"
  description="Khám phá các mẫu bàn thờ treo chung cư 48x81, 48x89cm, bàn thờ đứng 61x107cm, tranh Trúc Chỉ hoa sen đèn LED. 100% gỗ lõi không rác, bảo hành 10-20 năm."
  schema={catalogSchema}
>
  {/* Category Header */}
  <div class="bg-gradient-to-b from-[#1C100A] to-[#25150E] text-white py-14 sm:py-20 border-b-4 border-[#CFA439]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <span class="inline-block px-4 py-1.5 bg-[#2E1A11] text-[#E2BE5F] text-xs font-semibold rounded-full uppercase tracking-wider border border-[#CFA439]/40">
        100% Gỗ Lõi Tự Nhiên • Đền Bù 200% Nếu Pha Rác
      </span>
      <h1 class="text-3xl sm:text-5xl font-serif-luxury font-black text-[#FBF5DF]">
        Bộ Sưu Tập Bàn Thờ & Phụ Kiện Phòng Thờ
      </h1>
      <p class="text-[#D8C7B5] text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
        Tất cả sản phẩm đều được cắt chuẩn theo Cung Đỏ Thước Lỗ Ban 38.8cm, ghép mộng đục thắt truyền thống không dùng đinh kim loại trên mặt bàn thờ.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {/* Product Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {PRODUCTS.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    {/* Custom Order Box for Phú Thọ Workshop */}
    <div class="mt-16 bg-[#180D07] text-white p-8 sm:p-12 rounded-3xl border-2 border-[#CFA439]/40 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3 text-center md:text-left">
        <span class="text-[#CFA439] text-xs font-bold uppercase tracking-widest block">
          Xưởng Mộc Phú Thọ — Năng Lực May Đo Đại Quy Mô
        </span>
        <h3 class="text-2xl sm:text-3xl font-serif-luxury font-bold text-[#FBF5DF]">
          Gia Chủ Cần Thi Công Trọn Gói Phòng Thờ Theo Bản Vẽ 3D?
        </h3>
        <p class="text-[#D8C7B5] text-xs sm:text-sm max-w-2xl leading-relaxed">
          Xưởng gia đình tại Đoan Hùng, Phú Thọ chuyên nhận đóng án gian sập thờ ngũ phúc, cuốn thư câu đối bằng gỗ Gụ Lào, Gõ Đỏ Pachy, Mít Ta theo bản vẽ thiết kế của Kiến Trúc Sư.
        </p>
      </div>

      <a
        href="https://zalo.me/0339533380"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 bg-gradient-to-r from-[#CFA439] to-[#AF8729] hover:from-[#E2BE5F] hover:to-[#CFA439] text-[#190F0A] font-bold text-sm rounded-xl shadow-lg transition-all shrink-0 whitespace-nowrap"
      >
        Gửi Bản Vẽ 3D Qua Zalo
      </a>
    </div>
  </div>
</Layout>
