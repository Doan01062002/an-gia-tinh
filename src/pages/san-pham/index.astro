---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Danh Mục Bàn Thờ Hiện Đại & Phụ Kiện Phòng Thờ An Gia Tịnh',
  itemListElement: PRODUCTS.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `https://an-gia-tinh.vercel.app/san-pham/${item.slug}`,
  })),
};
---

<Layout
  title="Bộ Sưu Tập Bàn Thờ Hiện Đại Chuẩn Lỗ Ban 38.8cm — An Gia Tịnh"
  description="Khám phá các mẫu bàn thờ treo chung cư 48x81, 48x89cm, bàn thờ đứng 61x107cm, tranh Trúc Chỉ hoa sen đèn LED. 100% gỗ lõi không rác, bảo hành 10-20 năm."
  schema={catalogSchema}
>
  {/* Category Header */}
  <section class="bg-gradient-to-b from-stone-100/90 to-stone-50 border-b border-stone-200 py-14 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-900 text-xs font-semibold tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
        <span>100% Gỗ Lõi Tự Nhiên • Đền Bù 200% Nếu Pha Rác</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-serif font-black text-stone-900 tracking-tight">
        Bộ Sưu Tập Bàn Thờ & Phụ Kiện Phòng Thờ
      </h1>

      <p class="text-stone-600 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Tất cả sản phẩm đều được xưởng mộc cắt chuẩn theo Cung Đỏ Thước Lỗ Ban 38.8cm (Âm Phần), kết cấu mộng đục thắt truyền thống không đinh kim loại trên mặt bàn thờ.
      </p>

      {/* Quick category filter anchors */}
      <div class="pt-2 flex flex-wrap items-center justify-center gap-2 text-xs font-medium">
        <span class="px-3.5 py-1.5 rounded-full bg-white border border-stone-300 text-stone-900 shadow-xs">
          Tất cả sản phẩm ({PRODUCTS.length})
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-stone-100 hover:bg-white border border-stone-200 text-stone-600 transition-colors">
          Bàn thờ treo chung cư
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-stone-100 hover:bg-white border border-stone-200 text-stone-600 transition-colors">
          Bàn thờ đứng gia tiên
        </span>
        <span class="px-3.5 py-1.5 rounded-full bg-stone-100 hover:bg-white border border-stone-200 text-stone-600 transition-colors">
          Tranh Trúc Chỉ & Vách CNC
        </span>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {/* Product Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {PRODUCTS.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    {/* Custom Order Box for Phú Thọ Workshop */}
    <div class="mt-16 bg-gradient-to-br from-stone-900 via-stone-950 to-stone-900 text-white p-8 sm:p-12 rounded-3xl border border-stone-800 shadow-xl flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3 text-center md:text-left">
        <span class="text-amber-400 text-xs font-bold uppercase tracking-widest block">
          Xưởng Mộc Phú Thọ — Năng Lực May Đo Đại Quy Mô
        </span>
        <h3 class="text-2xl sm:text-3xl font-serif font-black text-white">
          Gia Chủ Cần Thi Công Trọn Gói Phòng Thờ Theo Bản Vẽ 3D?
        </h3>
        <p class="text-stone-300 text-xs sm:text-sm max-w-2xl leading-relaxed font-light">
          Xưởng gia đình tại Đoan Hùng, Phú Thọ chuyên nhận đóng án gian sập thờ ngũ phúc, cuốn thư câu đối bằng gỗ Gụ Lào, Gõ Đỏ Pachy, Mít Ta sấy lò ẩm độ 10–12% theo bản vẽ thiết kế của Kiến Trúc Sư.
        </p>
      </div>

      <a
        href="https://zalo.me/0339533380"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-sm rounded-xl shadow-lg transition-all shrink-0 whitespace-nowrap flex items-center gap-2 group"
      >
        <span>Gửi Bản Vẽ 3D Qua Zalo</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
