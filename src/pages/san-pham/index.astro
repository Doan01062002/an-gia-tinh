---
import Layout from '../../layouts/Layout.astro';
import ProductGallery from '../../components/ProductGallery';
import { PRODUCTS } from '../../data/products';

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Danh Mục Bàn Thờ Hiện Đại & Phụ Kiện Phòng Thờ An Gia Tịnh',
  itemListElement: PRODUCTS.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: `https://an-gia-tinh.vercel.app/san-pham/${item.slug}`,
  })),
};
---

<Layout
  title="Bộ Sưu Tập Bàn Thờ Hiện Đại Chuẩn Lỗ Ban 38.8cm — An Gia Tịnh"
  description="Khám phá các mẫu bàn thờ treo chung cư 48x81, 48x89cm, bàn thờ đứng 61x107cm, tranh Trúc Chỉ hoa sen đèn LED. 100% gỗ lõi không rác, bảo hành 10-20 năm."
  schema={catalogSchema}
>
  {/* Category Header */}
  <section class="bg-gradient-to-b from-stone-100/90 to-stone-50 border-b border-stone-200 py-8 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-900 text-xs font-semibold tracking-wide">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-600 animate-pulse"></span>
        <span>100% Gỗ Lõi Tự Nhiên • Đền Bù 200% Nếu Pha Rác</span>
      </div>

      <h1 class="text-2xl sm:text-4xl  font-black text-stone-900 tracking-tight">
        Bộ Sưu Tập Bàn Thờ & Phụ Kiện Phòng Thờ
      </h1>

      <p class="text-stone-600 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed font-light">
        Kích thước chuẩn Thước Lỗ Ban 38.8cm Cung Đỏ, kết cấu mộng đục thắt thủ công không đinh kim loại trên mặt bàn thờ.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {/* Product Gallery with Mobile Filter & Tap-to-Zoom */}
    <ProductGallery products={PRODUCTS} client:load />

    {/* Custom Order Box for Phú Thọ Workshop */}
    <div class="mt-14 bg-gradient-to-br from-[#802219] via-[#6d1b13] to-[#59140e] text-white p-6 sm:p-10 rounded-2xl border border-[#a83226] shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <span class="text-amber-400 text-xs font-bold uppercase tracking-widest block">
          Xưởng Mộc Đoan Hùng, Phú Thọ
        </span>
        <h3 class="text-xl sm:text-2xl  font-bold text-white">
          Thi Công May Đo Phòng Thờ Theo Bản Vẽ 3D Kiến Trúc Sư
        </h3>
        <p class="text-stone-300 text-xs sm:text-sm max-w-xl leading-relaxed font-light">
          Chuyên nhận đóng án gian sập thờ, cuốn thư câu đối bằng gỗ Gụ Lào, Gõ Đỏ Pachy, Mít Ta sấy lò 10–12%.
        </p>
      </div>

      <a
        href="https://zalo.me/0339533380?text=Chào xưởng An Gia Tịnh, tôi muốn gửi bản vẽ 3D thi công phòng thờ"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3.5 bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-xs sm:text-sm rounded-xl shadow-md transition-all shrink-0 whitespace-nowrap flex items-center gap-2 group"
      >
        <span>Gửi Bản Vẽ 3D Qua Zalo</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
